<UserControl x:Class="GameLoopOptimizer.Views.OptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:GameLoopOptimizer.Views.Controls"
             xmlns:models="clr-namespace:GameLoopOptimizer.Models"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1020">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Profile & Action Bar -->
        <Border Grid.Row="0" Style="{StaticResource GlowingHeroCard}" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Profile Selection -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="⚡ Optimization Profile Matrix" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0" />
                        <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="MEASUREMENT-DRIVEN" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" />
                        </Border>
                        <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding IsSafeModeActive, Converter={StaticResource BooleanToTextConverter}, ConverterParameter='🛡️ SAFE MODE|⚡ ACTIVE'}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentAmber}" />
                        </Border>
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal">
                        <RadioButton Content="Safe"
                                     Style="{StaticResource CategoryPill}"
                                     IsChecked="{Binding CurrentProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Safe}"
                                     Command="{Binding SelectProfileCommand}"
                                     CommandParameter="{x:Static models:OptimizationProfile.Safe}" />

                        <RadioButton Content="Balanced"
                                     Style="{StaticResource CategoryPill}"
                                     IsChecked="{Binding CurrentProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Balanced}"
                                     Command="{Binding SelectProfileCommand}"
                                     CommandParameter="{x:Static models:OptimizationProfile.Balanced}" />

                        <RadioButton Content="Max FPS"
                                     Style="{StaticResource CategoryPill}"
                                     IsChecked="{Binding CurrentProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=MaximumPerformance}"
                                     Command="{Binding SelectProfileCommand}"
                                     CommandParameter="{x:Static models:OptimizationProfile.MaximumPerformance}" />

                        <RadioButton Content="⚡ Competitive FPS"
                                     Style="{StaticResource CategoryPill}"
                                     IsChecked="{Binding CurrentProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Competitive}"
                                     Command="{Binding SelectProfileCommand}"
                                     CommandParameter="{x:Static models:OptimizationProfile.Competitive}" />

                        <RadioButton Content="🎯 Stable FPS"
                                     Style="{StaticResource CategoryPill}"
                                     IsChecked="{Binding CurrentProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=StableFps}"
                                     Command="{Binding SelectProfileCommand}"
                                     CommandParameter="{x:Static models:OptimizationProfile.StableFps}" />

                        <RadioButton Content="🌱 Low-End PC"
                                     Style="{StaticResource CategoryPill}"
                                     IsChecked="{Binding CurrentProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=LowEndPC}"
                                     Command="{Binding SelectProfileCommand}"
                                     CommandParameter="{x:Static models:OptimizationProfile.LowEndPC}" />

                        <RadioButton Content="🔋 Laptop / Battery"
                                     Style="{StaticResource CategoryPill}"
                                     IsChecked="{Binding CurrentProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=LaptopBattery}"
                                     Command="{Binding SelectProfileCommand}"
                                     CommandParameter="{x:Static models:OptimizationProfile.LaptopBattery}" />

                        <RadioButton Content="Custom"
                                     Style="{StaticResource CategoryPill}"
                                     IsChecked="{Binding CurrentProfile, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Custom}"
                                     Command="{Binding SelectProfileCommand}"
                                     CommandParameter="{x:Static models:OptimizationProfile.Custom}" />
                    </WrapPanel>
                </StackPanel>

                <!-- Main Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="💾 Export"
                            ToolTip="Export current tuning choices to JSON"
                            Command="{Binding ExportProfileCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,8"
                            FontSize="11"
                            Margin="0,0,6,0" />

                    <Button Content="📂 Import"
                            ToolTip="Import tuning profile from JSON"
                            Command="{Binding ImportProfileCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,8"
                            FontSize="11"
                            Margin="0,0,8,0" />

                    <Button Content="🔄 Restore"
                            Command="{Binding RestoreAllCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="14,10"
                            Margin="0,0,8,0" />

                    <Button Content="⚡ Optimize Selected"
                            Command="{Binding OptimizeSelectedCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="20,10" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- Category Filters & Selection Helpers -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Category Pills -->
            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="All Modules" Style="{StaticResource CategoryPill}" IsChecked="{Binding SelectedCategory, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=All}" />
                <RadioButton Content="Windows" Style="{StaticResource CategoryPill}" IsChecked="{Binding SelectedCategory, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Windows}" />
                <RadioButton Content="Power" Style="{StaticResource CategoryPill}" IsChecked="{Binding SelectedCategory, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Power}" />
                <RadioButton Content="GameLoop" Style="{StaticResource CategoryPill}" IsChecked="{Binding SelectedCategory, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=GameLoop}" />
                <RadioButton Content="Graphics" Style="{StaticResource CategoryPill}" IsChecked="{Binding SelectedCategory, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Graphics}" />
                <RadioButton Content="Memory &amp; Storage" Style="{StaticResource CategoryPill}" IsChecked="{Binding SelectedCategory, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Memory}" />
            </WrapPanel>

            <!-- Status / Batch Selection -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
                <Button Content="Select All" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11" Margin="0,0,6,0" />
                <Button Content="Deselect All" Command="{Binding DeselectAllCommand}" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11" />
            </StackPanel>
        </Grid>

        <!-- Module Cards Scroll List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding VisibleCards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:OptimizationCard />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
