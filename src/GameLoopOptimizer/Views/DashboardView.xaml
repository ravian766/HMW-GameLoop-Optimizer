<UserControl x:Class="GameLoopOptimizer.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:GameLoopOptimizer.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="880" d:DesignWidth="1020">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">

            <!-- ==================== HERO COCKPIT COMMAND DECK ==================== -->
            <Border Style="{StaticResource GlowingHeroCard}" Margin="0,0,0,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="System Optimization Cockpit" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0" />
                            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="PRO ENGINE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" />
                            </Border>
                        </StackPanel>
                        
                        <TextBlock Text="Hardware-aware Windows kernel, direct DirectX+ pipeline, and Android VM tuning for stutter-free PUBG Mobile."
                                   FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <!-- Quick Summary Chips -->
                        <WrapPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,5" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="HARDWARE TIER: " FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Recommendations.TierLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,5" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ENGINE: " FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding GameLoop.IsRunning, Converter={StaticResource BooleanToRunningStatusConverter}}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,5" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="BUILD: " FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DataContext.CurrentVersionDisplay, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyanBright}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Score Gauge & Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <controls:CircularGauge Value="{Binding Score.TotalScore}" Width="138" Height="138" Margin="0,0,22,0" />

                        <StackPanel VerticalAlignment="Center">
                            <Button Content="🔥 Pro Esports Setup"
                                    ToolTip="1-Click Maximum Performance: Competitive Profile, GPU Driver Tuning, 0.5ms Timer, Standby RAM Purge, and 120 FPS Unlock"
                                    Command="{Binding ProEsportsOptimizeCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="20,11"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Margin="0,0,0,8" />

                            <Button Content="⚡ Quick Optimize"
                                    ToolTip="Applies recommended safe system and GameLoop tweaks"
                                    Command="{Binding QuickOptimizeCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="18,8"
                                    FontSize="12"
                                    Margin="0,0,0,8" />

                            <Button Content="🔍 Re-Scan System"
                                    Command="{Binding ScanSystemCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="18,8"
                                    FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== REAL-TIME TELEMETRY MATRIX ==================== -->
            <TextBlock Text="LIVE HARDWARE &amp; PROCESS TELEMETRY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="2,0,0,10" />
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0" Style="{StaticResource MetricTile}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="CPU LOAD" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                        <TextBlock Text="{Binding CurrentCpu, StringFormat='{}{0:F1}%'}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,4,0,4" />
                        <ProgressBar Value="{Binding CurrentCpu}" Maximum="100" Height="4" Foreground="{DynamicResource BrushAccentCyan}" Background="{DynamicResource BrushBgInput}" BorderThickness="0" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Hardware.CpuName}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- GPU Card -->
                <Border Grid.Column="1" Style="{StaticResource MetricTile}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="GPU LOAD" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                        <TextBlock Text="{Binding CurrentGpu, StringFormat='{}{0:F1}%'}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource BrushAccentViolet}" Margin="0,4,0,4" />
                        <ProgressBar Value="{Binding CurrentGpu}" Maximum="100" Height="4" Foreground="{DynamicResource BrushAccentViolet}" Background="{DynamicResource BrushBgInput}" BorderThickness="0" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Hardware.GpuName}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Grid.Column="2" Style="{StaticResource MetricTile}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="RAM USAGE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                        <TextBlock Text="{Binding CurrentRam, StringFormat='{}{0:F0}%'}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" Margin="0,4,0,4" />
                        <ProgressBar Value="{Binding CurrentRam}" Maximum="100" Height="4" Foreground="{DynamicResource BrushAccentGreen}" Background="{DynamicResource BrushBgInput}" BorderThickness="0" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Hardware.TotalRamGb, StringFormat='Total: {0:F1} GB RAM'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                    </StackPanel>
                </Border>

                <!-- Disk Card -->
                <Border Grid.Column="3" Style="{StaticResource MetricTile}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="DISK ACTIVITY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                        <TextBlock Text="{Binding CurrentDiskMb, StringFormat='{}{0:F1} MB/s'}" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource BrushAccentAmber}" Margin="0,4,0,4" />
                        <ProgressBar Value="{Binding CurrentDiskMb}" Maximum="150" Height="4" Foreground="{DynamicResource BrushAccentAmber}" Background="{DynamicResource BrushBgInput}" BorderThickness="0" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Hardware.SystemDrive, StringFormat='Storage: {0}', FallbackValue='Storage: Primary SSD'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== OPTIMIZATION BREAKDOWN & DIAGNOSTICS ==================== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Category Scores Matrix -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Optimization Score Breakdown" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,16" />

                        <!-- Windows OS -->
                        <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Windows OS &amp; Game Mode Engine" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding Score.WindowsConfig.Details}" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Score.WindowsConfig.Score, StringFormat='{}{0}/20 pts'}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="{Binding Score.WindowsConfig.Score}" Maximum="20" Height="3" Foreground="{DynamicResource BrushAccentCyan}" Background="{DynamicResource BrushBgCard}" BorderThickness="0" />
                            </Grid>
                        </Border>

                        <!-- Power -->
                        <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Power Delivery &amp; Core Unparking" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding Score.PowerDelivery.Details}" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Score.PowerDelivery.Score, StringFormat='{}{0}/15 pts'}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="{Binding Score.PowerDelivery.Score}" Maximum="15" Height="3" Foreground="{DynamicResource BrushAccentCyan}" Background="{DynamicResource BrushBgCard}" BorderThickness="0" />
                            </Grid>
                        </Border>

                        <!-- GameLoop Config -->
                        <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="GameLoop Virtual Engine &amp; ADB" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding Score.GameLoopConfig.Details}" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Score.GameLoopConfig.Score, StringFormat='{}{0}/25 pts'}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="{Binding Score.GameLoopConfig.Score}" Maximum="25" Height="3" Foreground="{DynamicResource BrushAccentCyan}" Background="{DynamicResource BrushBgCard}" BorderThickness="0" />
                            </Grid>
                        </Border>

                        <!-- Graphics -->
                        <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="DirectX+ &amp; Persistent Shader Caching" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding Score.GraphicsSettings.Details}" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Score.GraphicsSettings.Score, StringFormat='{}{0}/20 pts'}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="{Binding Score.GraphicsSettings.Score}" Maximum="20" Height="3" Foreground="{DynamicResource BrushAccentCyan}" Background="{DynamicResource BrushBgCard}" BorderThickness="0" />
                            </Grid>
                        </Border>

                        <!-- Memory/Cache -->
                        <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Memory, In-VM Cache &amp; Storage Overhead" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding Score.MemoryStorage.Details}" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Score.MemoryStorage.Score, StringFormat='{}{0}/10 pts'}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="{Binding Score.MemoryStorage.Score}" Maximum="10" Height="3" Foreground="{DynamicResource BrushAccentCyan}" Background="{DynamicResource BrushBgCard}" BorderThickness="0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Technical Analysis & Recommendations -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Technical Diagnostics &amp; Insights" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,12" />
                        
                        <ItemsControl ItemsSource="{Binding ScoreExplanations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== DEEP JUNK CLEANER & EMULATOR DIAGNOSTIC STUDIO ==================== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Deep Junk Cleaner Card -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="🧹 Deep Emulator Junk &amp; Cache Cleaner" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,8,0" />
                                    <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushAccentAmber}" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                        <TextBlock Text="{Binding JunkScanResult.TotalSizeFormatted, StringFormat='{}{0} Junk'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccentAmber}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Safely purges DirectX/GPU driver shader caches, crash dumps, and temp buffers." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                            </StackPanel>
                        </Grid>

                        <!-- Junk Categories List -->
                        <ItemsControl ItemsSource="{Binding JunkScanResult.Categories}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeFormatted}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Cleaner Actions -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="⚡ Deep Clean"
                                    Command="{Binding ExecuteDeepCleanCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="14,7"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Content="🔍 Re-Scan"
                                    Command="{Binding ScanJunkCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,7"
                                    FontSize="11"
                                    Margin="0,0,8,0" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CleanerStatusMessage}"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushAccentGreen}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Fresh Start Emulator Diagnostic Card -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="10,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="🛠️ Fresh Start &amp; Health Diagnostics" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,8,0" />
                                    <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushAccentGreen}" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                        <TextBlock Text="{Binding HealthReport.StatusBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding HealthReport.SummaryText}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                            </StackPanel>
                        </Grid>

                        <!-- Diagnostic Issues List -->
                        <ItemsControl ItemsSource="{Binding HealthReport.Issues}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentAmber}" />
                                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Recommendation, StringFormat='Tip: {0}'}" FontSize="10" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Diagnostic Actions -->
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="🔍 Re-Run Diagnostics"
                                    Command="{Binding RunDiagnosticCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,7"
                                    FontSize="11"
                                    Margin="0,0,8,0" />
                            <Button Content="🔧 Auto-Repair Basic Issues"
                                    Command="{Binding AutoRepairIssuesCommand}"
                                    Style="{StaticResource SuccessButton}"
                                    Padding="14,7"
                                    FontSize="11"
                                    FontWeight="Bold" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
