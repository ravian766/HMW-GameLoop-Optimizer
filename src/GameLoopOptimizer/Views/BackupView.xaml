<UserControl x:Class="GameLoopOptimizer.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Restore All Bar -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Backup &amp; Reversion Ledger" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                    <TextBlock Text="Every registry, power, and GameLoop modification is snapshotted before application and can be reverted individually or completely."
                               FontSize="12" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#00E5FF" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Clear History"
                            Command="{Binding ClearHistoryCommand}"
                            Style="{StaticResource DangerButton}"
                            Padding="12,8"
                            Margin="0,0,10,0" />

                    <Button Content="Restore All Modifications"
                            Command="{Binding RestoreAllCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="18,10" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Backup List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Backups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#131722" BorderBrush="#1D2536" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                    </WrapPanel>

                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding TargetPath, StringFormat='Target: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Original Value: " FontSize="11" Foreground="#64748B" />
                                        <TextBlock Text="{Binding PreviousValue, FallbackValue='(None)'}" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1" Margin="0,0,12,0" />
                                        
                                        <TextBlock Text="New Value: " FontSize="11" Foreground="#64748B" />
                                        <TextBlock Text="{Binding NewValue}" FontSize="11" FontWeight="SemiBold" Foreground="#00E5FF" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Border Background="#1A2436" CornerRadius="6" Padding="8,4" Margin="0,0,8,0" Visibility="{Binding IsReverted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="REVERTED" FontSize="10" FontWeight="Bold" Foreground="#00E676" />
                                    </Border>

                                    <Button Content="Rollback This"
                                            Command="{Binding DataContext.RestoreSingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,6"
                                            FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
