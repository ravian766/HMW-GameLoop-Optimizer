<UserControl x:Class="GameLoopOptimizer.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="940">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Restore All Bar -->
        <Border Grid.Row="0" Style="{StaticResource GlowingHeroCard}" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Backup &amp; Reversion Ledger" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
                    <TextBlock Text="Every registry, power, and GameLoop modification is snapshotted before application and can be reverted individually or completely."
                               FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button Content="🗑️ Clear History"
                            Command="{Binding ClearHistoryCommand}"
                            Style="{StaticResource DangerButton}"
                            Padding="14,10"
                            Margin="0,0,10,0" />

                    <Button Content="🔄 Restore All Modifications"
                            Command="{Binding RestoreAllCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="20,10" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Backup List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Backups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BrushCardGradient}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                    </WrapPanel>

                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding TargetPath, StringFormat='Target: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ORIGINAL: " FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PreviousValue, FallbackValue='(None)'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        
                                        <TextBlock Text="MODIFIED: " FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding NewValue}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushAccentGreen}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" Visibility="{Binding IsReverted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="REVERTED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" />
                                    </Border>

                                    <Button Content="Rollback This"
                                            Command="{Binding DataContext.RestoreSingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="12,6"
                                            FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
