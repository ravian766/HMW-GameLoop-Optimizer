<UserControl x:Class="GameLoopOptimizer.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:GameLoopOptimizer.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="820" d:DesignWidth="1020">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">

            <!-- Title Header -->
            <Border Style="{StaticResource GlowingHeroCard}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Hardware Performance Telemetry" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0" />
                            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="1000ms RESOLUTION" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Real-time 1-second system resource monitoring and emulator frame-time pacing analytics." FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>

                    <!-- Real-Time Frame Metrics & Throttling Status -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <!-- FPS Status Chip -->
                        <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushAccentGreen}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="LIVE FPS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Metrics.FpsDisplayLabel}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Metrics.OnePercentLowFps, StringFormat='1% Low: {0:F0}'}" FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Frame Pacing Jitter Chip -->
                        <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="EST. JITTER" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Metrics.EstimatedFrametimeVarianceMs, StringFormat='{}{0:F1} ms'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyanBright}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Metrics.StutterIndexPercent, StringFormat='Stutter: {0:F0}%'}" FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Throttling Alert Badge -->
                        <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushAccentAmber}" BorderThickness="1" CornerRadius="8" Padding="10,6"
                                Visibility="{Binding Metrics.IsThermalThrottling, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="⚠️ THERMAL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushAccentAmber}" HorizontalAlignment="Center" />
                                <TextBlock Text="THROTTLING" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentAmber}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2x2 Real-Time Graphs Grid -->
            <Grid Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. CPU History Chart -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassCardHover}" Margin="0,0,8,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="CPU UTILIZATION (%)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                            <TextBlock Text="{Binding Metrics.CpuTotalPercent, StringFormat='{}{0:F1}%'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" HorizontalAlignment="Right" />
                        </Grid>
                        <controls:LiveChartControl PointsSource="{Binding CpuHistory}" MaxValue="100" Height="140" LineBrush="{DynamicResource BrushAccentCyan}" />
                    </StackPanel>
                </Border>

                <!-- 2. GPU History Chart -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassCardHover}" Margin="8,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="GPU 3D RASTERIZER (%)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                            <TextBlock Text="{Binding Metrics.GpuPercent, StringFormat='{}{0:F1}%'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushAccentViolet}" HorizontalAlignment="Right" />
                        </Grid>
                        <controls:LiveChartControl PointsSource="{Binding GpuHistory}" MaxValue="100" Height="140" LineBrush="{DynamicResource BrushAccentViolet}" />
                    </StackPanel>
                </Border>

                <!-- 3. RAM History Chart -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassCardHover}" Margin="0,0,8,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="RAM USAGE (%)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                            <TextBlock Text="{Binding Metrics.RamPercent, StringFormat='{}{0:F0}%'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" HorizontalAlignment="Right" />
                        </Grid>
                        <controls:LiveChartControl PointsSource="{Binding RamHistory}" MaxValue="100" Height="140" LineBrush="{DynamicResource BrushAccentGreen}" />
                    </StackPanel>
                </Border>

                <!-- 4. Disk I/O History Chart -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassCardHover}" Margin="8,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="DISK THROUGHPUT (MB/s)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                            <TextBlock Text="{Binding Metrics.DiskReadMbSec, StringFormat='{}{0:F1} MB/s'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushAccentAmber}" HorizontalAlignment="Right" />
                        </Grid>
                        <controls:LiveChartControl PointsSource="{Binding DiskHistory}" MaxValue="60" Height="140" LineBrush="{DynamicResource BrushAccentAmber}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Individual CPU Core / Thread Load Strip -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18"
                    Visibility="{Binding CoreLoads.Count, Converter={StaticResource IntGreaterThanZeroToVisibilityConverter}, FallbackValue=Visible}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="INDIVIDUAL CPU LOGICAL PROCESSOR THREAD LOADS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                        <TextBlock Text="{Binding Metrics.CpuTotalPercent, StringFormat='Aggregate: {0:F1}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding CoreLoads}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,6" Width="68">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding CoreLabel}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding LoadPercent, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" HorizontalAlignment="Center" Margin="0,1,0,2" />
                                        <ProgressBar Value="{Binding LoadPercent}" Maximum="100" Height="3" Width="50" Foreground="{DynamicResource BrushAccentCyan}" Background="{DynamicResource BrushBgCard}" BorderThickness="0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Detailed Telemetry Card (4 Columns) -->
            <Border Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MEMORY HEADROOM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                        <TextBlock Text="{Binding Metrics.RamUsedGb, StringFormat='Used: {0:F1} GB'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,2" />
                        <TextBlock Text="{Binding Metrics.RamAvailableGb, StringFormat='Available: {0:F1} GB'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentGreen}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="GPU VRAM FOOTPRINT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                        <TextBlock Text="{Binding Metrics.GpuVramUsedMb, StringFormat='Used: {0:F0} MB'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,2" />
                        <TextBlock Text="{Binding Metrics.VramPercent, StringFormat='Saturation: {0:F0}%'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentViolet}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock Text="GAMELOOP ENGINE MEMORY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                        <TextBlock Text="{Binding Metrics.GameLoopRamMb, StringFormat='Process: {0:F0} MB'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,2" />
                        <TextBlock Text="{Binding Metrics.IsGameLoopActive, Converter={StaticResource BooleanToStatusTextConverter}, FallbackValue='Running'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentCyan}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="8,0,0,0">
                        <TextBlock Text="STORAGE &amp; TEMPERATURES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                        <TextBlock Text="{Binding Metrics.DiskReadMbSec, StringFormat='Disk I/O: {0:F1} MB/s'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,2" />
                        <TextBlock Text="{Binding Metrics.CpuTemperatureC, StringFormat='CPU Temp: {0:F0}°C', FallbackValue='Sensor Standby'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
