<UserControl x:Class="GameLoopOptimizer.Views.GameLoopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="940">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">

            <!-- Top Emulator Status Header -->
            <Border Style="{StaticResource GlowingHeroCard}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="GameLoop Virtualization &amp; ADB Studio" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0" />
                            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Config.Brand, FallbackValue='GameLoop'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="Direct hardware-aware emulator engine allocation, Direct3D rasterization, and in-VM ADB Android tuning." FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Config.InstallPath, StringFormat='Root: {0}', FallbackValue='Root: Auto-Detected'}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="🚀 Launch / Focus GameLoop"
                            Command="{Binding LaunchGameLoopCommand}"
                            Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Center"
                            Padding="20,12" />
                </Grid>
            </Border>

            <!-- Recommendation Summary Banner -->
            <Border Background="{DynamicResource BrushCardGradient}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="⚡ Dynamic Hardware Recommendation" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Recommendations.RecommendationSummary}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Current Active In-Game Configuration Card -->
            <Border Background="{DynamicResource BrushCardGradient}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯 Current Active In-Game &amp; Engine Configuration" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Registry Synced" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentGreen}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- 4-Column Metric Badge Grid -->
                    <UniformGrid Grid.Row="1" Columns="4">
                        <!-- Profile & Device -->
                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="DEVICE FINGERPRINT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding SelectedDeviceProfile.DisplayName, FallbackValue='ASUS ROG Phone 2'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- Refresh & FPS Target -->
                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="TARGET REFRESH RATE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding FpsLevel, StringFormat='{}{0} FPS (High-Refresh)'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" />
                            </StackPanel>
                        </Border>

                        <!-- Graphics Preset & Scaling -->
                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="GRAPHICS &amp; CLARITY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding CurrentGraphicsAndScaleDisplay}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- Engine Allocation & Res -->
                        <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="VM ENGINE &amp; RESOLUTION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding CurrentEngineAndResDisplay}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Virtual Engine & Allocation -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Virtual Engine &amp; Allocation" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CPU Cores -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="CPU Core Count Allocation" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding CpuCores}">
                                <ComboBoxItem Content="2 Cores (Low-End / Dual-Core Host)" Tag="{Binding Path=2, FallbackValue=2}" />
                                <ComboBoxItem Content="4 Cores (Recommended Sweet Spot)" Tag="{Binding Path=4, FallbackValue=4}" />
                                <ComboBoxItem Content="6 Cores (High Core-Count Host)" Tag="{Binding Path=6, FallbackValue=6}" />
                                <ComboBoxItem Content="8 Cores (Multi-Threaded Workstation)" Tag="{Binding Path=8, FallbackValue=8}" />
                            </ComboBox>
                        </StackPanel>

                        <!-- RAM MB -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="RAM Memory Allocation" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding RamMb}">
                                <ComboBoxItem Content="2048 MB (2 GB - Minimal)" Tag="{Binding Path=2048, FallbackValue=2048}" />
                                <ComboBoxItem Content="4096 MB (4 GB - Standard)" Tag="{Binding Path=4096, FallbackValue=4096}" />
                                <ComboBoxItem Content="8192 MB (8 GB - High Performance)" Tag="{Binding Path=8192, FallbackValue=8192}" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Checkboxes -->
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <CheckBox Content="Force DirectX+ Hardware Rasterizer (Recommended)" IsChecked="{Binding ForceDirectX}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,24,6" />
                        <CheckBox Content="Enable Local Shader Caching (Eliminates Stutters)" IsChecked="{Binding ShaderCacheEnabled}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
                    </WrapPanel>

                    <!-- Actions Grid -->
                    <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button Content="Save Custom Settings"
                                Command="{Binding ApplySettingsCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="14,7"
                                FontSize="11"
                                Margin="0,0,8,6" />

                        <Button Content="Apply Recommended"
                                Command="{Binding ApplyRecommendedCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,7"
                                FontSize="11"
                                Margin="0,0,8,6" />

                        <Button Content="🔄 Restart GameLoop"
                                Command="{Binding RestartGameLoopCommand}"
                                Style="{StaticResource SuccessButton}"
                                Padding="14,7"
                                FontSize="11"
                                Margin="0,0,8,6" />

                        <Button Content="🧹 Purge Shader Cache"
                                Command="{Binding PurgeShaderCacheCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,7"
                                FontSize="11"
                                Margin="0,0,8,6" />

                        <Button Content="⚡ Desktop Shortcut"
                                Command="{Binding CreateShortcutCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,7"
                                FontSize="11"
                                Margin="0,0,0,6" />
                    </WrapPanel>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentCyan}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- ADB Android VM Subsystem & In-Emulator Tuning -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🤖 Android VM Subsystem &amp; ADB In-Emulator Studio" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0" />
                                <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushAccentGreen}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding AdbStatusText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="Direct low-latency bridge to GameLoop's Android container. Pre-compiles bytecode, optimizes input polling to 240Hz, unlocks 120Hz compositor, and monitors in-VM memory." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                        </StackPanel>

                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Text="{Binding CustomAdbPortText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="110"
                                     FontSize="11"
                                     FontFamily="Consolas"
                                     Padding="6,4"
                                     Margin="0,0,4,0"
                                     VerticalAlignment="Center"
                                     ToolTip="Custom Emulator IP:Port (e.g., 127.0.0.1:5555 or 127.0.0.1:6555)" />
                            <Button Content="🔌 Connect"
                                    Command="{Binding ConnectCustomPortCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,7"
                                    FontSize="11"
                                    Margin="0,0,6,0" />
                            <Button Content="⚡ 1-Click ADB Boost"
                                    Command="{Binding ApplyAllAdbOptimizationsCommand}"
                                    Style="{StaticResource SuccessButton}"
                                    Padding="12,7"
                                    FontSize="11"
                                    Margin="0,0,6,0" />
                            <Button Content="📸 Screen"
                                    Command="{Binding CaptureInVmScreenshotCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="9,7"
                                    FontSize="11"
                                    Margin="0,0,6,0" />
                            <Button Content="🧹 Trim Cache"
                                    Command="{Binding TrimInVmCacheCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="9,7"
                                    FontSize="11"
                                    Margin="0,0,6,0" />
                            <Button Content="🔄 Restart"
                                    Command="{Binding RestartAdbServerCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="9,7"
                                    FontSize="11" />
                        </WrapPanel>
                    </Grid>

                    <!-- Top Row: Game Package Selector & AOT Dex2Oat Compiler + Live Telemetry -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- AOT Dex2Oat Native Compiler Card & Game Lifecycle -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🚀 GAME LIFECYCLE &amp; AOT DEX COMPILER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding InstalledGamePackages}"
                                              SelectedItem="{Binding SelectedGamePackage}"
                                              DisplayMemberPath="DisplayName"
                                              Width="200"
                                              FontSize="11"
                                              Padding="6,3" />
                                </Grid>

                                <!-- Game Quick Actions Bar -->
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="▶ Launch Game"
                                            Command="{Binding LaunchGameCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="10,5"
                                            FontSize="11"
                                            Margin="0,0,6,4" />
                                    <Button Content="🛑 Force Stop"
                                            Command="{Binding ForceStopGameCommand}"
                                            Style="{StaticResource DangerButton}"
                                            Padding="10,5"
                                            FontSize="11"
                                            Margin="0,0,6,4" />
                                    <Button Content="📦 Sideload APK"
                                            Command="{Binding InstallApkCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,5"
                                            FontSize="11"
                                            Margin="0,0,6,4" />
                                    <Button Content="📍 Touch Overlay"
                                            Command="{Binding TogglePointerLocationCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,5"
                                            FontSize="11"
                                            Margin="0,0,6,4"
                                            ToolTip="Toggle on-screen touch coordinate and tap pointer crosshairs for keymap calibration" />
                                    <Button Content="🧹 Clear Data"
                                            Command="{Binding ClearGameDataCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="8,5"
                                            FontSize="11"
                                            Margin="0,0,0,4"
                                            ToolTip="Clear game application state data via ADB pm clear" />
                                </WrapPanel>

                                <TextBlock Text="Translates game bytecode into native machine code ahead-of-time. Permanently eliminates hot-drop, vehicle driving, and grenade explosion frame-drops." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource BrushCardBackground}" CornerRadius="6" Padding="8,6" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AdbCompilationStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentCyan}" TextWrapping="Wrap" />
                                    </Border>
                                    <Button Grid.Column="1"
                                            Content="⚡ Pre-Compile (AOT)"
                                            Command="{Binding CompileGameDexCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="12,6"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding IsAdbCompiling, Converter={StaticResource InverseBooleanConverter}}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Live In-VM Diagnostics & Telemetry Card -->
                        <Border Grid.Column="1" Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📊 LIVE IN-VM TELEMETRY &amp; MEMORY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="🔄 Refresh Stats"
                                            Command="{Binding RefreshTelemetryCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="8,3"
                                            FontSize="10" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource BrushCardBackground}" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="TOTAL PSS RAM" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                            <TextBlock Text="{Binding AdbTelemetry.Memory.TotalPssMb, StringFormat='{}{0:F1} MB'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource BrushCardBackground}" CornerRadius="6" Padding="8,6" Margin="2,0,2,0">
                                        <StackPanel>
                                            <TextBlock Text="GFX / VRAM" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                            <TextBlock Text="{Binding AdbTelemetry.Memory.GraphicsMb, StringFormat='{}{0:F1} MB'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource BrushCardBackground}" CornerRadius="6" Padding="8,6" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="VM VIEWPORT" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" />
                                            <TextBlock Text="{Binding AdbTelemetry.Display.EffectiveResolution}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding AdbTelemetry.Memory.SummaryDisplay}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Middle Row: In-VM ADB Feature Toggles -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="COMPOSITION, REFRESH, AUDIO &amp; INPUT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,0,8" />
                                <CheckBox Content="Zero UI Animation Latency (0.0x Scale)" IsChecked="{Binding AdbZeroAnimations}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
                                <CheckBox Content="SurfaceFlinger Pure GPU Hardware Rasterizer" IsChecked="{Binding AdbGpuAcceleration}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
                                <CheckBox Content="Low-Latency VSync Latch (500µs Offset)" IsChecked="{Binding AdbGpuAcceleration}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
                                <CheckBox Content="240Hz High-Speed Input Dispatch &amp; Aim Polling" IsChecked="{Binding AdbInputPolling}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
                                <CheckBox Content="True 120Hz Android SurfaceFlinger Refresh Unlock" IsChecked="{Binding Adb120FpsUnlock}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
                                <CheckBox Content="Fast-Track Low-Latency Audio (Bypass Deep Buffer)" IsChecked="{Binding AdbAudioLatencyReduction}" Foreground="{DynamicResource BrushTextPrimary}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="MEMORY HEAP, NETWORK &amp; BACKGROUND" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,0,8" />
                                <CheckBox Content="1024MB Dalvik Heap Ceiling (Eliminate GC Stutter)" IsChecked="{Binding AdbDalvikHeapBoost}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
                                <CheckBox Content="Suppress Verbose Logcat &amp; Debug Telemetry" IsChecked="{Binding AdbSuppressLogging}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
                                <CheckBox Content="Disable Android Adaptive Battery &amp; App Standby" IsChecked="{Binding AdbDisableDoze}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
                                <CheckBox Content="Sync Low-Jitter DNS (1.1.1.1) &amp; In-VM TCP Buffers" IsChecked="{Binding AdbInVmDnsSync}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
                                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="📐 Apply In-VM Resolution"
                                            Command="{Binding SetInVmResolutionCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="10,4"
                                            FontSize="10"
                                            Margin="0,0,6,0" />
                                    <Button Content="↩ Reset In-VM Res"
                                            Command="{Binding ResetInVmResolutionCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="8,4"
                                            FontSize="10" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Bottom Row: Interactive ADB Shell Mini Console -->
                    <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="💻 INTERACTIVE ADB SHELL CONSOLE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="Clear Console"
                                        Command="{Binding ClearConsoleOutputCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="8,3"
                                        FontSize="10" />
                            </Grid>

                            <TextBox Text="{Binding InteractiveAdbOutput, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     Height="90"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource BrushCardBackground}"
                                     Foreground="{DynamicResource BrushTextPrimary}"
                                     BorderThickness="1"
                                     BorderBrush="{DynamicResource BrushBorderSubtle}"
                                     Padding="8"
                                     Margin="0,0,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding InteractiveAdbCommand, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Padding="8,6"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="▶ Execute Shell"
                                        Command="{Binding ExecuteCustomAdbShellCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="14,6"
                                        FontSize="11"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- In-Game PUBG Mobile Settings Recommendation Guide -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="PUBG Mobile In-Game Configuration Guide" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
                    <TextBlock Text="For the lowest frame-time spikes and most responsive input latency, configure your in-game settings as follows:" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="GRAPHICS TAB" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,0,6" />
                                <TextBlock Text="• Graphics: Smooth" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3" />
                                <TextBlock Text="• Frame Rate: 90 fps / Extreme" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3" />
                                <TextBlock Text="• Style: Colorful" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="ADVANCED TAB" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,0,6" />
                                <TextBlock Text="• Anti-Aliasing: Disabled" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3" />
                                <TextBlock Text="• Shadows: Disabled" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3" />
                                <TextBlock Text="• Brightness: 115% - 130%" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="AUDIO &amp; SYSTEM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,0,6" />
                                <TextBlock Text="• Auto-Adjust Graphics: OFF" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3" />
                                <TextBlock Text="• Non-Standard Screens: Normal" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3" />
                                <TextBlock Text="• Sound Quality: High" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Gaming DNS & Ping Benchmark Tool -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🌐 Gaming DNS &amp; Server Latency Benchmark" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                            <TextBlock Text="Test regional PUBG server latency and flush your Windows DNS cache for lowest packet jitter." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="🧹 Flush DNS Cache"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,8"
                                Margin="0,0,8,0"
                                Command="{Binding FlushDnsCommand}" />
                        <Button Grid.Column="2"
                                Content="⚡ Benchmark Latency"
                                Style="{StaticResource SuccessButton}"
                                Padding="16,8"
                                Command="{Binding BenchmarkPingCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding PingResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding RegionName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
