<UserControl x:Class="GameLoopOptimizer.Views.GameLoopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">

            <!-- Top Emulator Status Header -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="GameLoop Virtualization Studio" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,0" />
                            <Border Background="#1F293D" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Config.Brand, FallbackValue='GameLoop'}" FontSize="11" FontWeight="SemiBold" Foreground="#00E5FF" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="Direct hardware-aware emulator engine and PUBG Mobile profile configuration." FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Config.InstallPath, StringFormat='Installation: {0}', FallbackValue='Path: Auto-Detected'}" FontSize="11" Foreground="#64748B" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Launch / Focus GameLoop"
                            Command="{Binding LaunchGameLoopCommand}"
                            Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Center"
                            Padding="16,10" />
                </Grid>
            </Border>

            <!-- Recommendation Summary Banner -->
            <Border Background="#121826" BorderBrush="#1F2A3F" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Dynamic Hardware Recommendation" FontSize="13" FontWeight="SemiBold" Foreground="#00E5FF" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Recommendations.RecommendationSummary}" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Config Form Grid -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Engine Settings -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Engine &amp; Resource Allocation" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                        <!-- CPU Cores -->
                        <TextBlock Text="CPU Core Count Allocation" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding CpuCores}" Margin="0,0,0,12">
                            <ComboBoxItem Content="2 Cores (Low-End / Dual-Core Host)" Tag="{Binding Path=2, FallbackValue=2}" />
                            <ComboBoxItem Content="4 Cores (Recommended Sweet Spot)" Tag="{Binding Path=4, FallbackValue=4}" />
                            <ComboBoxItem Content="6 Cores (High Core-Count Host)" Tag="{Binding Path=6, FallbackValue=6}" />
                            <ComboBoxItem Content="8 Cores (Multi-Threaded Workstation)" Tag="{Binding Path=8, FallbackValue=8}" />
                        </ComboBox>

                        <!-- RAM MB -->
                        <TextBlock Text="RAM Memory Size" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding RamMb}" Margin="0,0,0,12">
                            <ComboBoxItem Content="2048 MB (2 GB - Minimal)" Tag="{Binding Path=2048, FallbackValue=2048}" />
                            <ComboBoxItem Content="4096 MB (4 GB - Standard)" Tag="{Binding Path=4096, FallbackValue=4096}" />
                            <ComboBoxItem Content="8192 MB (8 GB - High Performance)" Tag="{Binding Path=8192, FallbackValue=8192}" />
                        </ComboBox>

                        <!-- Rendering Engine -->
                        <CheckBox Content="Force DirectX+ Hardware Rasterizer (Recommended)" IsChecked="{Binding ForceDirectX}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8" />

                        <!-- Shader Cache -->
                        <CheckBox Content="Enable Local Shader Caching (Eliminates Stutters)" IsChecked="{Binding ShaderCacheEnabled}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
                    </StackPanel>
                </Border>

                <!-- Right Column: PUBG Mobile Display & Profile -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="PUBG Mobile Display &amp; Frame Rate" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                        <!-- Device Profile -->
                        <TextBlock Text="PUBG Mobile Device Fingerprint Profile" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding DeviceProfiles}"
                                  SelectedItem="{Binding SelectedDeviceProfile}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,12" />

                        <!-- Target FPS -->
                        <TextBlock Text="PUBG Target FPS Level" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding FpsLevel}" Margin="0,0,0,12">
                            <ComboBoxItem Content="60 FPS (Standard 60Hz Displays)" Tag="{Binding Path=60, FallbackValue=60}" />
                            <ComboBoxItem Content="90 FPS (Smooth High Refresh)" Tag="{Binding Path=90, FallbackValue=90}" />
                            <ComboBoxItem Content="120 FPS (ROG Phone 2 Profile - Ultra Smooth)" Tag="{Binding Path=120, FallbackValue=120}" />
                        </ComboBox>

                        <!-- Resolution -->
                        <TextBlock Text="Emulator Resolution" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedResolutionString}" Margin="0,0,0,12">
                            <ComboBoxItem Content="1280 x 720 (720p - Maximum FPS on Low-End)" Tag="1280x720" />
                            <ComboBoxItem Content="1920 x 1080 (1080p - Balanced 1080p)" Tag="1920x1080" />
                            <ComboBoxItem Content="2560 x 1440 (2K - High-End Dedicated GPU)" Tag="2560x1440" />
                        </ComboBox>

                        <!-- Actions Grid -->
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Save Custom Settings"
                                    Command="{Binding ApplySettingsCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="10,6"
                                    Margin="0,0,6,6" />

                            <Button Content="Apply Recommended"
                                    Command="{Binding ApplyRecommendedCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,6"
                                    Margin="0,0,6,6" />

                            <Button Content="Restart GameLoop / TGB"
                                    Command="{Binding RestartGameLoopCommand}"
                                    Style="{StaticResource SuccessButton}"
                                    Padding="10,6"
                                    Margin="0,0,6,6" />

                            <Button Content="🧹 Purge Shader Cache"
                                    Command="{Binding PurgeShaderCacheCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,6"
                                    Margin="0,0,6,6" />

                            <Button Content="⚡ Create Desktop Shortcut"
                                    Command="{Binding CreateShortcutCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,6"
                                    Margin="0,0,0,6" />
                        </WrapPanel>

                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#00F0FF" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- In-Game PUBG Mobile Settings Recommendation Guide -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <TextBlock Text="PUBG Mobile In-Game Recommended Settings Guide" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10" />
                    <TextBlock Text="For the lowest frame-time spikes and most responsive input latency, configure your in-game settings as follows:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#101520" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="GRAPHICS TAB" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,4" />
                                <TextBlock Text="• Graphics: Smooth" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,2" />
                                <TextBlock Text="• Frame Rate: 90 fps / Extreme" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,2" />
                                <TextBlock Text="• Style: Colorful" FontSize="12" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#101520" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="ADVANCED TAB" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,4" />
                                <TextBlock Text="• Anti-Aliasing: Disabled" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,2" />
                                <TextBlock Text="• Shadows: Disabled" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,2" />
                                <TextBlock Text="• Brightness: 115% - 130%" FontSize="12" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#101520" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="AUTO-ADJUST" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,4" />
                                <TextBlock Text="• Auto-Adjust Graphics: OFF" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,2" />
                                <TextBlock Text="• Non-Standard Screens: Normal" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,2" />
                                <TextBlock Text="• Sound Quality: Ultra" FontSize="12" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
