<UserControl x:Class="GameLoopOptimizer.Views.GameLoopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:GameLoopOptimizer.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1020">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">

            <!-- ==================== TOP EMULATOR STATUS HEADER ==================== -->
            <Border Style="{StaticResource GlowingHeroCard}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🎮 GameLoop Virtualization &amp; ADB Studio" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0" />
                            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Config.Brand, FallbackValue='GameLoop'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Direct hardware-aware emulator engine allocation, Direct3D rasterization, and in-VM ADB Android tuning." FontSize="12.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding Config.InstallPath, StringFormat='Root: {0}', FallbackValue='Root: Auto-Detected'}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="🚀 Launch / Focus GameLoop"
                            Command="{Binding LaunchGameLoopCommand}"
                            Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Center"
                            Padding="20,12"
                            Margin="16,0,0,0" />
                </Grid>
            </Border>

            <!-- ==================== RECOMMENDATIONS & QUICK STATUS BADGES ==================== -->
            <Grid Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Recommendation Summary Banner -->
                <Border Grid.Row="0" Background="{DynamicResource BrushCardGradient}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushAccentCyan}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="⚡ SMART ENGINE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Recommendations.RecommendationSummary}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- 4-Column Metric Badge Grid -->
                <UniformGrid Grid.Row="1" Columns="4">
                    <!-- Profile & Device -->
                    <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="DEVICE FINGERPRINT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding DeviceProfiles}"
                                      SelectedItem="{Binding SelectedDeviceProfile}"
                                      DisplayMemberPath="DisplayName"
                                      FontSize="11"
                                      FontWeight="Bold"
                                      Padding="4,2"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      Foreground="{DynamicResource BrushTextPrimary}" />
                        </StackPanel>
                    </Border>

                    <!-- Refresh & FPS Target -->
                    <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="TARGET REFRESH RATE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding FpsLevel, StringFormat='{}{0} FPS (High-Refresh)'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" />
                        </StackPanel>
                    </Border>

                    <!-- Graphics Preset & Scaling -->
                    <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="GRAPHICS &amp; CLARITY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding CurrentGraphicsAndScaleDisplay}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- Engine Allocation & Res -->
                    <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="VM ENGINE &amp; RESOLUTION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding CurrentEngineAndResDisplay}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <!-- ==================== SEGMENTED WORKSPACE TABS ==================== -->
            <TabControl Style="{StaticResource SegmentedTabControl}">

                <!-- ==================== TAB 1: ENGINE & ALLOCATION ==================== -->
                <TabItem Header="🎛️  Engine &amp; Allocation" Style="{StaticResource SegmentedTabItem}">
                    <StackPanel>
                        <!-- Virtual Engine & Hardware Allocation -->
                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Virtual Engine &amp; Hardware Allocation" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,14" />

                                <!-- CPU & RAM Allocation Inputs -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- CPU Cores -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="CPU Core Count Allocation" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding CpuCores}">
                                            <ComboBoxItem Content="2 Cores (Low-End / Dual-Core Host)">
                                                <ComboBoxItem.Tag><sys:Int32>2</sys:Int32></ComboBoxItem.Tag>
                                            </ComboBoxItem>
                                            <ComboBoxItem Content="4 Cores (Recommended Sweet Spot)">
                                                <ComboBoxItem.Tag><sys:Int32>4</sys:Int32></ComboBoxItem.Tag>
                                            </ComboBoxItem>
                                            <ComboBoxItem Content="6 Cores (High Core-Count Host)">
                                                <ComboBoxItem.Tag><sys:Int32>6</sys:Int32></ComboBoxItem.Tag>
                                            </ComboBoxItem>
                                            <ComboBoxItem Content="8 Cores (Multi-Threaded Workstation)">
                                                <ComboBoxItem.Tag><sys:Int32>8</sys:Int32></ComboBoxItem.Tag>
                                            </ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- RAM MB -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="RAM Memory Allocation" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding RamMb}">
                                            <ComboBoxItem Content="2048 MB (2 GB - Minimal)">
                                                <ComboBoxItem.Tag><sys:Int32>2048</sys:Int32></ComboBoxItem.Tag>
                                            </ComboBoxItem>
                                            <ComboBoxItem Content="4096 MB (4 GB - Standard)">
                                                <ComboBoxItem.Tag><sys:Int32>4096</sys:Int32></ComboBoxItem.Tag>
                                            </ComboBoxItem>
                                            <ComboBoxItem Content="8192 MB (8 GB - High Performance)">
                                                <ComboBoxItem.Tag><sys:Int32>8192</sys:Int32></ComboBoxItem.Tag>
                                            </ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Rendering Mode Checkboxes -->
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <CheckBox Content="DirectX+ Mode (Uncheck for OpenGL+)" IsChecked="{Binding ForceDirectX}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,24,6" />
                                    <CheckBox Content="Enable Local Shader Caching (Eliminates Stutters)" IsChecked="{Binding ShaderCacheEnabled}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6" />
                                </WrapPanel>

                                <!-- Actions Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="💾 Save Settings"
                                                Command="{Binding ApplySettingsCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                Padding="16,8"
                                                FontSize="11.5"
                                                Margin="0,0,8,4" />

                                        <Button Content="⚡ Apply Recommended"
                                                Command="{Binding ApplyRecommendedCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="14,8"
                                                FontSize="11.5"
                                                Margin="0,0,8,4" />

                                        <Button Content="🔄 Restart GameLoop"
                                                Command="{Binding RestartGameLoopCommand}"
                                                Style="{StaticResource SuccessButton}"
                                                Padding="14,8"
                                                FontSize="11.5"
                                                Margin="0,0,8,4" />

                                        <Button Content="🧹 Purge Shader Cache"
                                                Command="{Binding PurgeShaderCacheCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="14,8"
                                                FontSize="11.5"
                                                Margin="0,0,8,4" />

                                        <Button Content="⚡ Desktop Shortcut"
                                                Command="{Binding CreateShortcutCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="14,8"
                                                FontSize="11.5"
                                                Margin="0,0,0,4" />
                                    </WrapPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- In-Game Recommended Settings Guide -->
                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Recommended In-Game Graphic Tabs" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
                                <TextBlock Text="For the lowest frame-time spikes and most responsive input latency, configure your in-game tabs as follows:" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="GRAPHICS TAB" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,0,6" />
                                            <TextBlock Text="• Graphics: Smooth" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3" />
                                            <TextBlock Text="• Frame Rate: 90 fps / Extreme" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3" />
                                            <TextBlock Text="• Style: Colorful" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="ADVANCED TAB" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,0,6" />
                                            <TextBlock Text="• Anti-Aliasing: Disabled" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3" />
                                            <TextBlock Text="• Shadows: Disabled" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3" />
                                            <TextBlock Text="• Brightness: 115% - 130%" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="AUDIO &amp; SYSTEM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,0,6" />
                                            <TextBlock Text="• Auto-Adjust Graphics: OFF" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3" />
                                            <TextBlock Text="• Non-Standard Screens: Normal" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,3" />
                                            <TextBlock Text="• Sound Quality: High" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Gaming DNS & Ping Benchmark Tool -->
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🌐 Gaming DNS &amp; Server Latency Benchmark" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                        <TextBlock Text="Test regional PUBG server latency and flush your Windows DNS cache for lowest packet jitter." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="🧹 Flush DNS Cache"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="12,8"
                                            Margin="0,0,8,0"
                                            Command="{Binding FlushDnsCommand}" />
                                    <Button Grid.Column="2"
                                            Content="⚡ Benchmark Latency"
                                            Style="{StaticResource SuccessButton}"
                                            Padding="16,8"
                                            Command="{Binding BenchmarkPingCommand}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding PingResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding RegionName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ==================== TAB 2: ANDROID VM & ADB STUDIO ==================== -->
                <TabItem Header="🤖  Android VM &amp; ADB Studio" Style="{StaticResource SegmentedTabItem}">
                    <controls:AdbStudioControl />
                </TabItem>

                <!-- ==================== TAB 3: ACTIVE.SAV & 120 FPS ==================== -->
                <TabItem Header="🎯  UE4 Graphics &amp; Active.sav (120 FPS)" Style="{StaticResource SegmentedTabItem}">
                    <controls:ActiveSavControl />
                </TabItem>

            </TabControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
