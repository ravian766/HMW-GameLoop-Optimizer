<UserControl x:Class="GameLoopOptimizer.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="940">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Filter Bar -->
        <Border Grid.Row="0" Style="{StaticResource GlowingHeroCard}" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Optimization &amp; Telemetry Event Log" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" />
                    <TextBlock Text="Live auditable log of all system queries, registry updates, and rollback actions." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Width="220"
                             Padding="10,7"
                             Background="{DynamicResource BrushBgInput}"
                             Foreground="{DynamicResource BrushTextPrimary}"
                             BorderBrush="{DynamicResource BrushBorderLight}"
                             Margin="0,0,10,0" />

                    <Button Content="📋 Copy Logs"
                            Command="{Binding CopyLogsCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="14,8"
                            Margin="0,0,8,0" />

                    <Button Content="🗑️ Clear"
                            Command="{Binding ClearLogsCommand}"
                            Style="{StaticResource DangerButton}"
                            Padding="14,8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Console View -->
        <Border Grid.Row="1" Background="{DynamicResource BrushBgDarkest}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredLogs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Formatted}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
