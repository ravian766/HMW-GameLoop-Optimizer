<UserControl x:Class="GameLoopOptimizer.Views.GamingSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,24">

            <!-- Hero Session Controller Card -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Gaming Session Controller" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                        <TextBlock Text="Applies real-time thread priority boosts, 0.5ms timer resolution, and background CPU throttling, automatically reverting everything when your match finishes."
                                   FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <!-- Active Duration Readout -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SESSION TIME: " FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FormattedDuration}" FontSize="18" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Start / End Buttons -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="Start Gaming Session"
                                Command="{Binding StartSessionCommand}"
                                Style="{StaticResource SuccessButton}"
                                Padding="24,14"
                                FontSize="14"
                                FontWeight="Bold"
                                Margin="0,0,0,8" />

                        <Button Content="End Gaming Session"
                                Command="{Binding EndSessionCommand}"
                                Style="{StaticResource DangerButton}"
                                Padding="20,10"
                                FontSize="13" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live Session Metrics -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="AVERAGE CPU LOAD" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding Session.AvgCpuPercent, StringFormat='{}{0:F1}%'}" FontSize="24" FontWeight="Bold" Foreground="#00E5FF" Margin="0,4,0,2" />
                        <TextBlock Text="Host &amp; Emulator combined" FontSize="10" Foreground="#64748B" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="PEAK CPU SPIKE" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding Session.PeakCpuPercent, StringFormat='{}{0:F1}%'}" FontSize="24" FontWeight="Bold" Foreground="#FFB300" Margin="0,4,0,2" />
                        <TextBlock Text="Highest load recorded" FontSize="10" Foreground="#64748B" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="PEAK EMULATOR MEMORY" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding Session.PeakRamMb, StringFormat='{}{0:F0} MB'}" FontSize="24" FontWeight="Bold" Foreground="#00E676" Margin="0,4,0,2" />
                        <TextBlock Text="GameLoop footprint" FontSize="10" Foreground="#64748B" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Applied Session Tweaks List & Post-Match Summary -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Active Tweaks -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Temporary Session Tweaks" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10" />
                        <TextBlock Text="These temporary system modifications are active solely during your gaming match:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,12" />

                        <Border Background="#101522" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                            <TextBlock Text="✓ 0.5ms High-Precision Multimedia Timer" FontSize="12" Foreground="#00E5FF" />
                        </Border>
                        <Border Background="#101522" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                            <TextBlock Text="✓ GameLoop Process Priority: Above Normal" FontSize="12" Foreground="#00E5FF" />
                        </Border>
                        <Border Background="#101522" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                            <TextBlock Text="✓ Background Apps Throttled to Below Normal" FontSize="12" Foreground="#00E5FF" />
                        </Border>
                        <Border Background="#101522" CornerRadius="6" Padding="12,8">
                            <TextBlock Text="✓ Idle Process RAM Working Set Flushed" FontSize="12" Foreground="#00E5FF" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Session Report -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Post-Match Session Report" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding SummaryReport, FallbackValue='Start a session to record telemetry. When you click End Session, a full report will be generated and temporary changes will be reverted.'}"
                                   FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
