<Window x:Class="GameLoopOptimizer.Views.MiniOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HMW Mini Overlay"
        Height="46"
        Width="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="30"
        Top="30"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#E60A0D14"
            BorderBrush="#3300F0FF"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.75" ShadowDepth="2" />
        </Border.Effect>

        <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <Border Background="#1A00F0FF" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="HMW HUD" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" />
                </Border>
            </StackPanel>

            <!-- Metrics Bar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- CPU -->
                <TextBlock Text="CPU " FontSize="11" Foreground="#94A3B8" />
                <TextBlock x:Name="TxtCpu" Text="0%" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,12,0" />

                <!-- Host RAM -->
                <TextBlock Text="RAM " FontSize="11" Foreground="#94A3B8" />
                <TextBlock x:Name="TxtRam" Text="0%" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,12,0" />

                <!-- Emulator MB -->
                <TextBlock Text="GameLoop " FontSize="11" Foreground="#94A3B8" />
                <TextBlock x:Name="TxtEmulator" Text="0 MB" FontSize="11" FontWeight="SemiBold" Foreground="#00F0FF" Margin="0,0,12,0" />

                <!-- Timer -->
                <Border Background="#1A00E676" CornerRadius="3" Padding="4,1">
                    <TextBlock Text="0.50ms" FontSize="10" FontWeight="SemiBold" Foreground="#00E676" />
                </Border>
            </StackPanel>

            <!-- Close overlay button -->
            <Button Grid.Column="2"
                    Content="✕"
                    Foreground="#94A3B8"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="10"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    Click="Close_Click" />
        </Grid>
    </Border>
</Window>
