<Window x:Class="GameLoopOptimizer.Views.MiniOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HMW In-Game Performance HUD"
        Height="48"
        Width="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="30"
        Top="30"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled">

    <Border Background="{DynamicResource BrushBgCard}"
            BorderBrush="{DynamicResource BrushBorderLight}"
            BorderThickness="1"
            CornerRadius="10"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">

        <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand / Game Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <Border x:Name="BadgeGame" Background="{DynamicResource BrushCyanGradient}" CornerRadius="5" Padding="7,3">
                    <TextBlock x:Name="TxtGameBadge" Text="HMW HUD" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                </Border>
            </StackPanel>

            <!-- Metrics Bar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- FPS -->
                <TextBlock Text="FPS " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                <TextBlock x:Name="TxtFps" Text="--" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" Margin="0,0,8,0" />

                <!-- 1% Low FPS -->
                <TextBlock Text="1% " FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                <TextBlock x:Name="TxtOnePercentLow" Text="--" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,10,0" />

                <!-- CPU -->
                <TextBlock Text="CPU " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                <TextBlock x:Name="TxtCpu" Text="0%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0" />

                <!-- Host RAM -->
                <TextBlock Text="RAM " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                <TextBlock x:Name="TxtRam" Text="0%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0" />

                <!-- Emulator MB -->
                <TextBlock Text="GL " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                <TextBlock x:Name="TxtEmulator" Text="0 MB" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,10,0" />

                <!-- Stutter Radar Badge -->
                <Border x:Name="BadgeRadar" Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushAccentGreen}" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtRadar" Text="⚡ Smooth" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" />
                </Border>

                <!-- Frametime Variance Micro-Indicator -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="VAR " FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" />
                    <TextBlock x:Name="TxtVariance" Text="0.8ms" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" />
                </StackPanel>

                <!-- Timer -->
                <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderLight}" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,8,0">
                    <TextBlock Text="0.50ms" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" />
                </Border>

                <!-- Click-Through Toggle Button -->
                <Button x:Name="BtnClickThrough"
                        Content="🔓 Move"
                        ToolTip="Toggle Click-Through Mode (pass clicks into GameLoop)"
                        Foreground="{DynamicResource BrushTextPrimary}"
                        Background="{DynamicResource BrushBgInput}"
                        BorderBrush="{DynamicResource BrushBorderLight}"
                        BorderThickness="1"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Padding="6,2"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Click="ToggleClickThrough_Click"
                        Margin="0,0,6,0" />
            </StackPanel>

            <!-- Close overlay button -->
            <Button Grid.Column="2"
                    Content="✕"
                    Foreground="{DynamicResource BrushTextMuted}"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="11"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    Click="Close_Click" />
        </Grid>
    </Border>
</Window>
