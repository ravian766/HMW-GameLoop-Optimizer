<UserControl x:Class="GameLoopOptimizer.Views.Controls.ActiveSavControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="980">
    <!-- PUBG Mobile UE4 Active.sav Direct Patcher -->
    <Border Style="{StaticResource GlassCard}">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PUBG Mobile UE4 In-Engine Graphics &amp; 120 FPS Patcher" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" />
                    <TextBlock Text="Injects true 90/120 FPS limits, Smooth/HDR quality, and styles directly into the active VM game save (Active.sav)." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="📥 Read Live"
                            Command="{Binding PullActiveSavCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,7"
                            FontSize="11"
                            Margin="0,0,8,0" />
                    <Button Content="↩ Restore Snapshot"
                            Command="{Binding RestoreActiveSavCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,7"
                            FontSize="11" />
                </StackPanel>
            </Grid>

            <!-- Presets Strip -->
            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="SELECT COMPETITIVE GRAPHICS PRESET" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding ActiveSavPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Command="{Binding DataContext.SelectActiveSavPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,7"
                                        FontSize="11"
                                        Margin="0,0,8,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding SelectedActiveSavPreset.Description}" FontSize="11.5" Foreground="{DynamicResource BrushAccentCyan}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Device Model & 120 FPS Spoofing Fingerprint -->
            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="DEVICE FINGERPRINT SPOOFING (90 / 120 FPS WHITELIST)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding DeviceProfiles}"
                                  SelectedItem="{Binding SelectedDeviceProfile}"
                                  DisplayMemberPath="DisplayName"
                                  FontSize="11.5"
                                  Padding="8,6" />
                        <Border Grid.Column="1" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedDeviceProfile.Description}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4 ComboBoxes Deck -->
            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Battle FPS -->
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Battle In-Game FPS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ActiveSavFpsLevel}">
                            <ComboBoxItem Content="60 FPS (Extreme)">
                                <ComboBoxItem.Tag><sys:Int32>5</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="90 FPS (Extreme+)">
                                <ComboBoxItem.Tag><sys:Int32>6</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="120 FPS (Ultra Extreme)">
                                <ComboBoxItem.Tag><sys:Int32>7</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Battle Quality -->
                    <StackPanel Grid.Column="1" Margin="3,0,3,0">
                        <TextBlock Text="Battle Quality" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ActiveSavBattleQuality}">
                            <ComboBoxItem Content="Smooth (Lowest Lag)">
                                <ComboBoxItem.Tag><sys:Int32>1</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="Balanced">
                                <ComboBoxItem.Tag><sys:Int32>2</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="HD">
                                <ComboBoxItem.Tag><sys:Int32>3</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="HDR">
                                <ComboBoxItem.Tag><sys:Int32>4</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="Ultra HD">
                                <ComboBoxItem.Tag><sys:Int32>5</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Visual Style -->
                    <StackPanel Grid.Column="2" Margin="3,0,3,0">
                        <TextBlock Text="Visual Style" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ActiveSavStyle}">
                            <ComboBoxItem Content="Classic (High Contrast)">
                                <ComboBoxItem.Tag><sys:Int32>1</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="Colorful (Vibrant)">
                                <ComboBoxItem.Tag><sys:Int32>2</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="Realistic">
                                <ComboBoxItem.Tag><sys:Int32>3</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="Soft">
                                <ComboBoxItem.Tag><sys:Int32>4</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="Movie">
                                <ComboBoxItem.Tag><sys:Int32>5</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <!-- Lobby FPS -->
                    <StackPanel Grid.Column="3" Margin="6,0,0,0">
                        <TextBlock Text="Lobby FPS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ActiveSavLobbyFpsLevel}">
                            <ComboBoxItem Content="60 FPS">
                                <ComboBoxItem.Tag><sys:Int32>5</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="90 FPS">
                                <ComboBoxItem.Tag><sys:Int32>6</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="120 FPS">
                                <ComboBoxItem.Tag><sys:Int32>7</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sync Action Footer -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="⚡ Inject &amp; Sync In-Game (ADB Live)"
                        Command="{Binding SyncActiveSavCommand}"
                        Style="{StaticResource SuccessButton}"
                        Padding="18,9"
                        FontSize="12"
                        FontWeight="Bold"
                        Margin="0,0,14,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ActiveSavStatusMessage}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushAccentGreen}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
