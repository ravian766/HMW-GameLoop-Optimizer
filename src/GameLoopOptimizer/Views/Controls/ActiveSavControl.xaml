<UserControl x:Class="GameLoopOptimizer.Views.Controls.ActiveSavControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="980">
    <!-- PUBG Mobile graphics save deployment.
         Replaced the byte-patching UI on 2026-10-11: patching the graphics fields into the
         existing save was not reliably adopted by the game, whereas deploying a complete save
         file that the game already accepts is verified to work in-game.
         The host view gates this control on a live ADB bridge. -->
    <Border Style="{StaticResource GlassCard}">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PUBG Mobile In-Game Graphics" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" />
                    <TextBlock Text="Deploy a verified graphics save (Ultra HD / 120 FPS) directly into the emulator." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <!-- Game lifecycle helpers. Deploy and the UE4 sync both refuse (or force-stop)
                         while the game runs and both leave it stopped; these buttons are the
                         one-click remedies around that state. -->
                    <Button Content="⏹ Stop Game"
                            Command="{Binding ForceStopGameCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,7"
                            FontSize="11"
                            ToolTip="Force-stops PUBG Mobile inside the VM so it cannot overwrite the save on exit"
                            Margin="0,0,8,0" />
                    <Button Content="▶ Launch Game"
                            Command="{Binding LaunchGameCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,7"
                            FontSize="11"
                            ToolTip="Starts PUBG Mobile so you can verify the applied tier in the Graphics menu"
                            Margin="0,0,8,0" />
                    <Button Content="📥 Read Live"
                            Command="{Binding PullActiveSavCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,7"
                            FontSize="11"
                            Margin="0,0,8,0" />
                    <Button Content="↩ Restore Snapshot"
                            Command="{Binding RestoreActiveSavCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,7"
                            FontSize="11" />
                </StackPanel>
            </Grid>

            <!-- Known-good save deployment.
                 This is the only supported way to change in-game graphics for now. The previous
                 byte-patching UI was removed because the patch was not reliably adopted by the
                 game; deploying a complete save that the game already accepts is verified to work. -->
            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="GRAPHICS PRESET FILE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,0,4" />
                    <TextBlock Text="Deploys a verified save file to the emulator. PUBG Mobile must be CLOSED - a running game overwrites the save when it exits."
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding BundledSaves}"
                                  SelectedItem="{Binding SelectedBundledSave}"
                                  DisplayMemberPath="DisplayName"
                                  FontSize="11.5"
                                  Padding="8,6"
                                  IsEnabled="{Binding HasBundledSaves}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <StackPanel>
                                                <!-- Full file identity: the label is a friendly preset name, the tooltip keeps the raw facts. -->
                                                <TextBlock Text="{Binding FileName}" FontWeight="Bold" />
                                                <TextBlock>
                                                    <Run Text="Size: " />
                                                    <Run Text="{Binding Length, Mode=OneWay}" />
                                                    <Run Text=" bytes" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <Button Grid.Column="1"
                                Content="⚡ Deploy Selected Save"
                                Command="{Binding DeployBundledSaveCommand}"
                                Style="{StaticResource SuccessButton}"
                                Padding="16,8"
                                FontSize="12"
                                FontWeight="Bold"
                                Margin="10,0,0,0"
                                IsEnabled="{Binding HasBundledSaves}" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
                                   VerticalAlignment="Center">
                            <Run Text="Adding a preset: " FontWeight="Bold" />
                            <Run Text="drop a .sav file into the Assets folder and click Rescan - no restart or code change needed." />
                        </TextBlock>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="↻ Rescan"
                                    Command="{Binding RescanCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,5"
                                    FontSize="11"
                                    ToolTip="Re-read the Assets folder for .sav preset files"
                                    Margin="0,0,6,0" />
                            <Button Content="📁 Open Assets Folder"
                                    Command="{Binding OpenAssetsFolderCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,5"
                                    FontSize="11"
                                    ToolTip="Open the folder this tab scans for preset files in Explorer" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Empty state. Uses InverseBooleanToVisibilityConverter: the built-in
                 BooleanToVisibilityConverter ignores ConverterParameter, so the previous
                 binding showed this banner exactly when files WERE found. The message now
                 names the scanned folder so an empty list is remotely diagnosable. -->
            <Border
                Visibility="{Binding HasBundledSaves, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                Background="{DynamicResource BrushBgInput}"
                BorderBrush="{DynamicResource BrushAccentRed}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource BrushAccentRed}"
                               Text="No save files were found. This tab scanned:" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
                               Text="{Binding BundledSaveScanPath}" Margin="0,4,0,0" />
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
                               Text="Drop a .sav preset file there (or click 📁 Open Assets Folder), then click ↻ Rescan." Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Status. Color follows the operation outcome; hardwired green used to make
                 verification failures read as success. -->
            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <TextBlock Text="{Binding ActiveSavStatusMessage}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{Binding LastOperationSucceeded, Converter={StaticResource BooleanToStatusBrushConverter}, ConverterParameter=danger}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
