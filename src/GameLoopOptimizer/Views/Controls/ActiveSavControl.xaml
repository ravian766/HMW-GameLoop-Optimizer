<UserControl x:Class="GameLoopOptimizer.Views.Controls.ActiveSavControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="980">
    <!-- PUBG Mobile graphics save deployment.
         Replaced the byte-patching UI on 2026-10-11: patching the graphics fields into the
         existing save was not reliably adopted by the game, whereas deploying a complete save
         file that the game already accepts is verified to work in-game.
         The host view gates this control on a live ADB bridge. -->
    <Border Style="{StaticResource GlassCard}">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PUBG Mobile In-Game Graphics" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" />
                    <TextBlock Text="Deploy a verified graphics save (Ultra HD / 120 FPS) directly into the emulator." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="📥 Read Live"
                            Command="{Binding PullActiveSavCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,7"
                            FontSize="11"
                            Margin="0,0,8,0" />
                    <Button Content="↩ Restore Snapshot"
                            Command="{Binding RestoreActiveSavCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,7"
                            FontSize="11" />
                </StackPanel>
            </Grid>

            <!-- Known-good save deployment.
                 This is the only supported way to change in-game graphics for now. The previous
                 byte-patching UI was removed because the patch was not reliably adopted by the
                 game; deploying a complete save that the game already accepts is verified to work. -->
            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="GRAPHICS PRESET FILE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,0,4" />
                    <TextBlock Text="Deploys a verified save file to the emulator. PUBG Mobile must be CLOSED - a running game overwrites the save when it exits."
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding BundledSaves}"
                                  SelectedItem="{Binding SelectedBundledSave}"
                                  DisplayMemberPath="DisplayName"
                                  FontSize="11.5"
                                  Padding="8,6"
                                  IsEnabled="{Binding HasBundledSaves}" />

                        <Button Grid.Column="1"
                                Content="⚡ Deploy Selected Save"
                                Command="{Binding DeployBundledSaveCommand}"
                                Style="{StaticResource SuccessButton}"
                                Padding="16,8"
                                FontSize="12"
                                FontWeight="Bold"
                                Margin="10,0,0,0"
                                IsEnabled="{Binding HasBundledSaves}" />
                    </Grid>

                    <Border Background="{DynamicResource BrushBgCardSubtle}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,10,0,0">
                        <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}">
                            <Run Text="Adding a preset: " FontWeight="Bold" />
                            <Run Text="drop a .sav file into the Assets folder next to the executable and restart the app. It appears in the list automatically - no code change needed." />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <Border
                Visibility="{Binding HasBundledSaves, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Collapsed}"
                Background="{DynamicResource BrushBgInput}"
                BorderBrush="{DynamicResource BrushAccentRed}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,14">
                <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource BrushAccentRed}"
                           Text="No save files were found in the Assets folder next to the executable." />
            </Border>

            <!-- Status -->
            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <TextBlock Text="{Binding ActiveSavStatusMessage}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushAccentGreen}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
