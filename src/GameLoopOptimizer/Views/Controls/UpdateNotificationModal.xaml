<UserControl x:Class="GameLoopOptimizer.Views.Controls.UpdateNotificationModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="600">

    <!-- Dimmed Frosted Backdrop Overlay -->
    <Grid Background="#99000000">
        <Border Width="560" MaxHeight="520"
                Background="{DynamicResource BrushBgCard}"
                BorderBrush="{DynamicResource BrushBorderLight}"
                BorderThickness="1.5"
                CornerRadius="16"
                Padding="28"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" Color="#00F2FE" Opacity="0.3" ShadowDepth="0" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header / Title -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Glowing Update Icon Badge -->
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                            Background="{DynamicResource BrushAccentCyanGlow}"
                            BorderBrush="{DynamicResource BrushAccentCyan}"
                            BorderThickness="1" Margin="0,0,14,0">
                        <TextBlock Text="🚀" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="New Update Available" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                            <Border Background="{DynamicResource BrushAccentCyanGlow}" BorderBrush="{DynamicResource BrushAccentCyan}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding AvailableUpdate.TagName}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding AvailableUpdate.ReleaseTitle, FallbackValue='New features and performance optimizations ready.'}" 
                                   FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Close 'X' Button -->
                    <Button Grid.Column="2" Content="✕" 
                            Command="{Binding DismissUpdateCommand}"
                            Style="{StaticResource WindowControlButton}" 
                            VerticalAlignment="Top" HorizontalAlignment="Right" />
                </Grid>

                <!-- Release Notes Box -->
                <Border Grid.Row="1" Background="{DynamicResource BrushBgDarkest}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16" MinHeight="160" MaxHeight="220">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="What's New in this Release:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushAccentCyanBright}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding AvailableUpdate.ReleaseNotes, FallbackValue='- Performance improvements and bug fixes.'}" 
                                       FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Progress / Status Area -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16" Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{Binding UpdateStatusMessage, FallbackValue='Downloading update...'}" FontSize="11" Foreground="{DynamicResource BrushAccentCyanBright}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding UpdateProgress, StringFormat='{}{0:F0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding UpdateProgress}"
                                 Foreground="{DynamicResource BrushAccentCyan}" Background="{DynamicResource BrushBgDarkest}" BorderThickness="0" />
                </StackPanel>

                <!-- Action Footer Buttons -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding AvailableUpdate.FormattedFileSize, StringFormat='{}Package Size: {0}'}"
                               FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />

                    <Button Grid.Column="1" Content="Remind Later" 
                            Command="{Binding DismissUpdateCommand}"
                            IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="16,8" Margin="0,0,10,0" />

                    <Button Grid.Column="2" 
                            Command="{Binding DownloadAndApplyUpdateCommand}"
                            IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="20,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Margin="0,0,6,0" />
                            <TextBlock Text="Update &amp; Restart" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
