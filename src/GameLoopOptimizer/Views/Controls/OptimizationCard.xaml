<UserControl x:Class="GameLoopOptimizer.Views.Controls.OptimizationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="130" d:DesignWidth="600">
    <Border Background="#141923"
            BorderBrush="#202A3C"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            Margin="0,0,0,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Checkbox -->
            <CheckBox IsChecked="{Binding IsSelected}"
                      VerticalAlignment="Top"
                      Margin="0,2,12,0" />

            <!-- Content Details -->
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <!-- Title & Tags -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="{Binding Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />

                    <!-- Risk Pill -->
                    <Border Background="#1C2433"
                            BorderBrush="{Binding RiskColor}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,2"
                            Margin="0,0,6,0">
                        <TextBlock Text="{Binding RiskLevel}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding RiskColor}" />
                    </Border>

                    <!-- Admin Tag -->
                    <Border Background="#33FF9100"
                            CornerRadius="10"
                            Padding="8,2"
                            Visibility="{Binding RequiresAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,0,6,0">
                        <TextBlock Text="ADMIN" FontSize="10" FontWeight="Bold" Foreground="#FF9100" />
                    </Border>
                </WrapPanel>

                <!-- Description -->
                <TextBlock Text="{Binding Description}"
                           FontSize="12"
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6" />

                <!-- Technical Rationale -->
                <TextBlock Text="{Binding TechnicalRationale}"
                           FontSize="11"
                           Foreground="#64748B"
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <!-- State comparison -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Current: " FontSize="11" Foreground="#64748B" />
                    <TextBlock Text="{Binding CurrentStateDisplay}" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1" Margin="0,0,12,0" />
                    
                    <TextBlock Text="Recommended: " FontSize="11" Foreground="#64748B" />
                    <TextBlock Text="{Binding RecommendedStateDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#00E5FF" />
                </StackPanel>
            </StackPanel>

            <!-- Actions & Status -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <!-- Status Badge -->
                <Border Background="#162030"
                        CornerRadius="6"
                        Padding="10,4"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,10">
                    <TextBlock Text="{Binding State}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{Binding StatusBadgeColor}" />
                </Border>

                <!-- Apply & Rollback Buttons -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="Apply"
                            Command="{Binding ApplyCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="12,6"
                            FontSize="11"
                            Margin="0,0,6,0" />

                    <Button Content="Rollback"
                            Command="{Binding RollbackCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,6"
                            FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
