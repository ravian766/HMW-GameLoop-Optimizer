<UserControl x:Class="GameLoopOptimizer.Views.Controls.OptimizationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="130" d:DesignWidth="620">
    <Border Style="{StaticResource GlassCardHover}"
            Margin="0,0,0,10"
            Padding="16"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Checkbox -->
            <CheckBox IsChecked="{Binding IsSelected}"
                      VerticalAlignment="Top"
                      Margin="0,4,14,0" />

            <!-- Content Details -->
            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                <!-- Title & Tags -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="{Binding Title}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />

                    <!-- Risk Pill -->
                    <Border Background="{DynamicResource BrushBgInput}"
                            BorderBrush="{Binding RiskColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,2"
                            Margin="0,0,6,0">
                        <TextBlock Text="{Binding RiskLevel}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{Binding RiskColor}" />
                    </Border>

                    <!-- Admin Tag -->
                    <Border Background="{DynamicResource BrushBgInput}"
                            BorderBrush="{DynamicResource BrushAccentAmber}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,2"
                            Visibility="{Binding RequiresAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,0,6,0">
                        <TextBlock Text="ADMIN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccentAmber}" />
                    </Border>
                </WrapPanel>

                <!-- Description -->
                <TextBlock Text="{Binding Description}"
                           FontSize="12"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />

                <!-- Technical Rationale -->
                <TextBlock Text="{Binding TechnicalRationale}"
                           FontSize="11"
                           Foreground="{DynamicResource BrushTextMuted}"
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <!-- State comparison -->
                <WrapPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CURRENT: " FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentStateDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="➔" FontSize="11" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushAccentCyan}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TARGET: " FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RecommendedStateDisplay}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyanBright}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>

            <!-- Actions & Status -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <!-- Status Badge -->
                <Border Background="{DynamicResource BrushBgInput}"
                        BorderBrush="{Binding StatusBadgeColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,4"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,10">
                    <TextBlock Text="{Binding State}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{Binding StatusBadgeColor}" />
                </Border>

                <!-- Apply & Rollback Buttons -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="Apply"
                            Command="{Binding ApplyCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="14,6"
                            FontSize="11"
                            Margin="0,0,6,0" />

                    <Button Content="Rollback"
                            Command="{Binding RollbackCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,6"
                            FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
