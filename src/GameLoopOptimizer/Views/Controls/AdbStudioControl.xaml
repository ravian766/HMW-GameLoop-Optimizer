<UserControl x:Class="GameLoopOptimizer.Views.Controls.AdbStudioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="980">
    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
        <StackPanel>
            <!-- Header with Connection & Quick Tools -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Android VM Subsystem &amp; ADB Bridge" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0" />
                        <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushAccentGreen}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AdbStatusText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Direct low-latency bridge to GameLoop's Android container. Optimizes input polling, cleans cache, and tunes runtime." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBox Text="{Binding CustomAdbPortText, UpdateSourceTrigger=PropertyChanged}"
                             Width="110"
                             FontSize="11.5"
                             FontFamily="Consolas"
                             Padding="8,6"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             ToolTip="Custom IP:Port (e.g., 127.0.0.1:5555)" />
                    <Button Content="🔌 Connect"
                            Command="{Binding ConnectCustomPortCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,7"
                            FontSize="11"
                            Margin="0,0,6,0" />
                    <Button Content="⚡ ADB Boost"
                            Command="{Binding ApplyAllAdbOptimizationsCommand}"
                            Style="{StaticResource SuccessButton}"
                            Padding="14,7"
                            FontSize="11"
                            Margin="0,0,6,0" />
                    <Button Content="📸 Screen"
                            Command="{Binding CaptureInVmScreenshotCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="9,7"
                            FontSize="11"
                            Margin="0,0,6,0" />
                    <Button Content="🧹 Trim Cache"
                            Command="{Binding TrimInVmCacheCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="9,7"
                            FontSize="11"
                            Margin="0,0,6,0" />
                    <Button Content="🔄 Restart ADB"
                            Command="{Binding RestartAdbServerCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="9,7"
                            FontSize="11" />
                </StackPanel>
            </Grid>

            <!-- Row 1: Game Lifecycle & AOT Dex Compiler + Live In-VM Diagnostics -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- AOT Dex2Oat Native Compiler Card -->
                <Border Grid.Column="0" Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🚀 GAME LIFECYCLE &amp; AOT DEX" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding InstalledGamePackages}"
                                      SelectedItem="{Binding SelectedGamePackage}"
                                      DisplayMemberPath="DisplayName"
                                      Width="180"
                                      FontSize="11"
                                      Padding="6,3" />
                        </Grid>

                        <!-- Game Quick Actions Bar -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="▶ Launch Game"
                                    Command="{Binding LaunchGameCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="10,5"
                                    FontSize="11"
                                    Margin="0,0,4,4" />
                            <Button Content="🛑 Force Stop"
                                    Command="{Binding ForceStopGameCommand}"
                                    Style="{StaticResource DangerButton}"
                                    Padding="10,5"
                                    FontSize="11"
                                    Margin="0,0,4,4" />
                            <Button Content="📦 Sideload APK"
                                    Command="{Binding InstallApkCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,5"
                                    FontSize="11"
                                    Margin="0,0,4,4" />
                            <Button Content="📍 Touch Overlay"
                                    Command="{Binding TogglePointerLocationCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,5"
                                    FontSize="11"
                                    Margin="0,0,4,4"
                                    ToolTip="Toggle on-screen touch crosshairs for keymap calibration" />
                            <Button Content="🧹 Clear Data"
                                    Command="{Binding ClearGameDataCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="10,5"
                                    FontSize="11"
                                    Margin="0,0,0,4"
                                    ToolTip="Clear game state via ADB pm clear" />
                        </WrapPanel>

                        <TextBlock Text="Translates game bytecode into native machine code ahead-of-time to eliminate hot-drop frame drops." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,8" TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource BrushCardBackground}" CornerRadius="6" Padding="8,6" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AdbCompilationStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentCyan}" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button Grid.Column="1"
                                    Content="⚡ Pre-Compile (AOT)"
                                    Command="{Binding CompileGameDexCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="14,6"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding IsAdbCompiling, Converter={StaticResource InverseBooleanConverter}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Live In-VM Diagnostics & Telemetry Card -->
                <Border Grid.Column="1" Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📊 LIVE IN-VM TELEMETRY &amp; MEMORY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="🔄 Refresh"
                                    Command="{Binding RefreshTelemetryCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="9,4"
                                    FontSize="10.5" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource BrushCardBackground}" CornerRadius="6" Padding="8,8" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="TOTAL PSS RAM" FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBlock Text="{Binding AdbTelemetry.Memory.TotalPssMb, StringFormat='{}{0:F1} MB'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource BrushCardBackground}" CornerRadius="6" Padding="8,8" Margin="2,0,2,0">
                                <StackPanel>
                                    <TextBlock Text="GFX / VRAM" FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBlock Text="{Binding AdbTelemetry.Memory.GraphicsMb, StringFormat='{}{0:F1} MB'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource BrushCardBackground}" CornerRadius="6" Padding="8,8" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="VM VIEWPORT" FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}" />
                                    <TextBlock Text="{Binding AdbTelemetry.Display.EffectiveResolution}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding AdbTelemetry.Memory.SummaryDisplay}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2: In-VM ADB Feature Toggles -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="COMPOSITION, REFRESH, AUDIO &amp; INPUT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,0,10" />
                        <CheckBox Content="Zero UI Animation Latency (0.0x Scale)" IsChecked="{Binding AdbZeroAnimations}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
                        <CheckBox Content="SurfaceFlinger Pure GPU Hardware Rasterizer" IsChecked="{Binding AdbGpuAcceleration}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
                        <CheckBox Content="240Hz High-Speed Input Dispatch &amp; Aim Polling" IsChecked="{Binding AdbInputPolling}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
                        <CheckBox Content="True 120Hz Android SurfaceFlinger Refresh Unlock" IsChecked="{Binding Adb120FpsUnlock}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
                        <CheckBox Content="Fast-Track Low-Latency Audio (Bypass Buffer)" IsChecked="{Binding AdbAudioLatencyReduction}" Foreground="{DynamicResource BrushTextPrimary}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="MEMORY HEAP, NETWORK &amp; RESOLUTION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,0,0,10" />
                        <CheckBox Content="1024MB Dalvik Heap Ceiling (Eliminate GC Stutter)" IsChecked="{Binding AdbDalvikHeapBoost}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
                        <CheckBox Content="Suppress Verbose Logcat &amp; Debug Telemetry" IsChecked="{Binding AdbSuppressLogging}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
                        <CheckBox Content="Disable Android Adaptive Battery &amp; App Standby" IsChecked="{Binding AdbDisableDoze}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
                        <CheckBox Content="Sync Low-Jitter DNS (1.1.1.1) &amp; In-VM TCP Buffers" IsChecked="{Binding AdbInVmDnsSync}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📐 Apply In-VM Res"
                                    Command="{Binding SetInVmResolutionCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,6"
                                    FontSize="11"
                                    Margin="0,0,8,0" />
                            <Button Content="↩ Reset In-VM Res"
                                    Command="{Binding ResetInVmResolutionCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,6"
                                    FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 3: Interactive ADB Shell Console -->
            <Border Background="{DynamicResource BrushBgInput}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="💻 INTERACTIVE ADB SHELL CONSOLE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Clear Console"
                                Command="{Binding ClearConsoleOutputCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,4"
                                FontSize="10.5" />
                    </Grid>

                    <TextBox Text="{Binding InteractiveAdbOutput, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             FontSize="11.5"
                             Height="100"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource BrushCardBackground}"
                             Foreground="{DynamicResource BrushTextPrimary}"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource BrushBorderSubtle}"
                             Padding="10"
                             Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding InteractiveAdbCommand, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                 FontSize="12"
                                 Padding="10,7"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="▶ Execute Shell"
                                Command="{Binding ExecuteCustomAdbShellCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="16,7"
                                FontSize="11.5"
                                VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
