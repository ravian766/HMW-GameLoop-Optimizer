<Window x:Class="GameLoopOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameLoopOptimizer"
        xmlns:vm="clr-namespace:GameLoopOptimizer.ViewModels"
        mc:Ignorable="d"
        Title="HMW - GameLoop &amp; Windows Performance Optimizer"
        Height="800" Width="1200"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgMain}"
        Foreground="{StaticResource BrushTextPrimary}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BrushBgSidebar}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="4,0,4,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="{StaticResource BrushCyanGradient}" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#06080D" />
                        </Border>
                        <TextBlock Text="HMW" FontSize="16" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="GAMELOOP" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="PUBG Mobile Performance Suite" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="36,0,0,0" />
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Row="1">
                    <RadioButton Content="📊  Dashboard"
                                 Style="{StaticResource NavTabButton}"
                                 IsChecked="True"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Dashboard" />

                    <RadioButton Content="⚡  Optimizer"
                                 Style="{StaticResource NavTabButton}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Optimizer" />

                    <RadioButton Content="🎮  GameLoop Studio"
                                 Style="{StaticResource NavTabButton}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="GameLoop" />

                    <RadioButton Content="📈  Performance Monitor"
                                 Style="{StaticResource NavTabButton}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Monitor" />

                    <RadioButton Content="🚀  Gaming Session"
                                 Style="{StaticResource NavTabButton}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="GamingSession" />

                    <RadioButton Content="🔄  Backup &amp; Rollback"
                                 Style="{StaticResource NavTabButton}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Backup" />

                    <RadioButton Content="📋  Optimization Logs"
                                 Style="{StaticResource NavTabButton}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Logs" />
                </StackPanel>

                <!-- Bottom System & Privilege Status Card -->
                <Border Grid.Row="2" Background="#111622" BorderBrush="#1C2436" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <!-- Admin Status -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛡️ " FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding IsAdmin, Converter={StaticResource BooleanToStatusTextConverter}, FallbackValue='Standard User'}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding IsAdmin, Converter={StaticResource BooleanToRunningStatusConverter}, FallbackValue='#94A3B8'}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Elevate"
                                    Command="{Binding ElevateCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="6,2"
                                    FontSize="10"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                        </Grid>

                        <Separator Background="#1E273A" Margin="0,4,0,6" />

                        <!-- Hardware Mini Summary -->
                        <TextBlock Text="{Binding Hardware.CpuName}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding Hardware.GpuName}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- Right Content Area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
    </Grid>
</Window>
