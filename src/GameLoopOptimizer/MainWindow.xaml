<Window x:Class="GameLoopOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameLoopOptimizer"
        xmlns:vm="clr-namespace:GameLoopOptimizer.ViewModels"
        mc:Ignorable="d"
        Title="HMW • GameLoop &amp; Windows Precision Optimizer"
        Height="820" Width="1240"
        MinHeight="700" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgMain}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BrushBgSidebar}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="4,0,4,28">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="{StaticResource BrushCyanGradient}" CornerRadius="7" Width="30" Height="30" Margin="0,0,12,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#00F2FE" Opacity="0.6" ShadowDepth="0" />
                            </Border.Effect>
                            <TextBlock Text="⚡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#04060A" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="HMW" FontSize="17" FontWeight="Bold" Foreground="#00F2FE" Margin="0,0,5,0" />
                                <TextBlock Text="OPTIMIZER" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" />
                            </StackPanel>
                            <TextBlock Text="GameLoop &amp; PUBG Suite" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="1,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Row="1">
                    <RadioButton Content="📊  Dashboard"
                                 Style="{StaticResource NavTabButton}"
                                 IsChecked="True"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Dashboard" />

                    <RadioButton Content="⚡  Optimizer Suite"
                                 Style="{StaticResource NavTabButton}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Optimizer" />

                    <RadioButton Content="🎮  GameLoop Studio"
                                 Style="{StaticResource NavTabButton}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="GameLoop" />

                    <RadioButton Content="📈  Performance Monitor"
                                 Style="{StaticResource NavTabButton}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Monitor" />

                    <RadioButton Content="🚀  Gaming Session"
                                 Style="{StaticResource NavTabButton}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="GamingSession" />

                    <RadioButton Content="🔄  Backup &amp; Rollback"
                                 Style="{StaticResource NavTabButton}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Backup" />

                    <RadioButton Content="📋  Optimization Logs"
                                 Style="{StaticResource NavTabButton}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Logs" />
                </StackPanel>

                <!-- Bottom System & Privilege Status Card -->
                <Border Grid.Row="2" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <!-- Admin Status -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛡️ " FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding IsAdmin, Converter={StaticResource BooleanToStatusTextConverter}, FallbackValue='Standard User'}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{Binding IsAdmin, Converter={StaticResource BooleanToRunningStatusConverter}, FallbackValue='#94A3B8'}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Elevate"
                                    Command="{Binding ElevateCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,3"
                                    FontSize="10"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                        </Grid>

                        <Separator Background="{StaticResource BrushBorderSubtle}" Margin="0,4,0,8" />

                        <!-- Hardware Mini Summary -->
                        <TextBlock Text="{Binding Hardware.CpuName}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding Hardware.GpuName}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- Right Content Area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
    </Grid>
</Window>
