<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== BACKGROUNDS (Deep Void Obsidian & Carbon Jet Black) ==================== -->
    <Color x:Key="BgDarkest">#050507</Color>
    <Color x:Key="BgSidebar">#09090C</Color>
    <Color x:Key="BgMain">#0C0C10</Color>
    <Color x:Key="BgCard">#131318</Color>
    <Color x:Key="BgCardHover">#1A1A22</Color>
    <Color x:Key="BgCardActive">#242430</Color>
    <Color x:Key="BgInput">#0E0E14</Color>
    <Color x:Key="BgPopup">#14141B</Color>
    <Color x:Key="BgGlassFrosted">#1E1E28</Color>

    <!-- ==================== ACCENT PALETTE (Punchy Cyber Ember Orange & High-Octane Neon) ==================== -->
    <!-- Punchy Electric Neon Orange (Primary Brand) -->
    <Color x:Key="AccentCyan">#FF6D00</Color>
    <Color x:Key="AccentCyanBright">#FF8F00</Color>
    <Color x:Key="AccentCyanDeep">#E65100</Color>
    <Color x:Key="AccentCyanGlow">#45FF6D00</Color>

    <!-- Hyper Amber & Solar Flame (Secondary) -->
    <Color x:Key="AccentViolet">#FF9E00</Color>
    <Color x:Key="AccentVioletDeep">#FF6D00</Color>
    <Color x:Key="AccentMagenta">#FF3D00</Color>
    <Color x:Key="AccentPink">#FF5722</Color>

    <!-- Quantum Mint Emerald (Success / Live Engine) -->
    <Color x:Key="AccentGreen">#00E676</Color>
    <Color x:Key="AccentGreenBright">#69F0AE</Color>
    <Color x:Key="AccentGreenDeep">#00C853</Color>
    <Color x:Key="AccentGreenGlow">#3300E676</Color>

    <!-- Solar Gold (Warning / Notice) -->
    <Color x:Key="AccentAmber">#FFAB00</Color>
    <Color x:Key="AccentAmberBright">#FFD600</Color>

    <!-- Lava Crimson (Danger / Offline) -->
    <Color x:Key="AccentRed">#FF1744</Color>
    <Color x:Key="AccentRuby">#D50000</Color>

    <!-- ==================== BORDER & STROKE SYSTEM ==================== -->
    <Color x:Key="BorderLight">#262630</Color>
    <Color x:Key="BorderSubtle">#181820</Color>
    <Color x:Key="BorderGlowCyan">#66FF6D00</Color>
    <Color x:Key="BorderCardTopHighlight">#40FF8F00</Color>
    <Color x:Key="BorderFrostedTop">#25FFFFFF</Color>

    <!-- ==================== TEXT HIERARCHY ==================== -->
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#A1A1AA</Color>
    <Color x:Key="TextMuted">#71717A</Color>

    <!-- ==================== SOLID COLOR BRUSHES ==================== -->
    <SolidColorBrush x:Key="BrushBgDarkest" Color="{StaticResource BgDarkest}" />
    <SolidColorBrush x:Key="BrushBgSidebar" Color="{StaticResource BgSidebar}" />
    <SolidColorBrush x:Key="BrushBgMain" Color="{StaticResource BgMain}" />
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource BgCard}" />
    <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource BgCardHover}" />
    <SolidColorBrush x:Key="BrushBgCardActive" Color="{StaticResource BgCardActive}" />
    <SolidColorBrush x:Key="BrushBgInput" Color="{StaticResource BgInput}" />
    <SolidColorBrush x:Key="BrushBgPopup" Color="{StaticResource BgPopup}" />
    <SolidColorBrush x:Key="BrushBgGlassFrosted" Color="{StaticResource BgGlassFrosted}" />

    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource AccentCyan}" />
    <SolidColorBrush x:Key="BrushAccentCyanBright" Color="{StaticResource AccentCyanBright}" />
    <SolidColorBrush x:Key="BrushAccentCyanDeep" Color="{StaticResource AccentCyanDeep}" />
    <SolidColorBrush x:Key="BrushAccentCyanGlow" Color="{StaticResource AccentCyanGlow}" />
    <SolidColorBrush x:Key="BrushAccentViolet" Color="{StaticResource AccentViolet}" />
    <SolidColorBrush x:Key="BrushAccentVioletDeep" Color="{StaticResource AccentVioletDeep}" />
    <SolidColorBrush x:Key="BrushAccentGreen" Color="{StaticResource AccentGreen}" />
    <SolidColorBrush x:Key="BrushAccentGreenBright" Color="{StaticResource AccentGreenBright}" />
    <SolidColorBrush x:Key="BrushAccentAmber" Color="{StaticResource AccentAmber}" />
    <SolidColorBrush x:Key="BrushAccentRed" Color="{StaticResource AccentRed}" />
    <SolidColorBrush x:Key="BrushAccentRuby" Color="{StaticResource AccentRuby}" />

    <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource BorderSubtle}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource TextMuted}" />

    <!-- ==================== PREMIUM GRADIENTS ==================== -->
    <!-- Obsidian Window Backdrop Mesh with Warm Ember Radiance -->
    <RadialGradientBrush x:Key="BrushWindowBackdropGradient" Center="0.5,0.0" GradientOrigin="0.5,0.0" RadiusX="1.0" RadiusY="1.0">
        <GradientStop Color="#1D130B" Offset="0" />
        <GradientStop Color="#0C0C10" Offset="0.5" />
        <GradientStop Color="#050507" Offset="1" />
    </RadialGradientBrush>

    <!-- Sidebar Mesh Gradient -->
    <LinearGradientBrush x:Key="BrushSidebarGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#09090C" Offset="0" />
        <GradientStop Color="#050508" Offset="1" />
    </LinearGradientBrush>

    <!-- Hero Electric Neon Orange Blaze Gradient -->
    <LinearGradientBrush x:Key="BrushCyanGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF7D00" Offset="0" />
        <GradientStop Color="#FF5400" Offset="0.5" />
        <GradientStop Color="#E64A19" Offset="1" />
    </LinearGradientBrush>

    <!-- Neon Sunset Blaze Gradient -->
    <LinearGradientBrush x:Key="BrushVioletGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFA000" Offset="0" />
        <GradientStop Color="#FF6D00" Offset="0.5" />
        <GradientStop Color="#E65100" Offset="1" />
    </LinearGradientBrush>

    <!-- Quantum Mint Emerald Gradient -->
    <LinearGradientBrush x:Key="BrushGreenGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#69F0AE" Offset="0" />
        <GradientStop Color="#00E676" Offset="0.6" />
        <GradientStop Color="#00C853" Offset="1" />
    </LinearGradientBrush>

    <!-- Solar Amber Glow Gradient -->
    <LinearGradientBrush x:Key="BrushAmberGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD600" Offset="0" />
        <GradientStop Color="#FFAB00" Offset="0.7" />
        <GradientStop Color="#FF6D00" Offset="1" />
    </LinearGradientBrush>

    <!-- Cyber Ruby Alert Gradient -->
    <LinearGradientBrush x:Key="BrushRubyGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5252" Offset="0" />
        <GradientStop Color="#FF1744" Offset="0.6" />
        <GradientStop Color="#D50000" Offset="1" />
    </LinearGradientBrush>

    <!-- Holographic Glass Card Surface Gradient -->
    <LinearGradientBrush x:Key="BrushCardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#16161D" Offset="0" />
        <GradientStop Color="#121217" Offset="0.4" />
        <GradientStop Color="#0D0D12" Offset="1" />
    </LinearGradientBrush>

    <!-- Hero Score Cockpit Gradient (Punchy High-Octane Ember) -->
    <LinearGradientBrush x:Key="BrushScoreGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF9100" Offset="0" />
        <GradientStop Color="#FF6D00" Offset="0.5" />
        <GradientStop Color="#FF3D00" Offset="1" />
    </LinearGradientBrush>

    <!-- Active Segment Tab Glowing Pill -->
    <LinearGradientBrush x:Key="BrushNavActiveGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#30FF6D00" Offset="0" />
        <GradientStop Color="#0CFF6D00" Offset="0.8" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <!-- Frosted Top-Border Highlight Stroke (Ember Rim Light) -->
    <LinearGradientBrush x:Key="BrushCardTopHighlight" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FF8F00" Offset="0" />
        <GradientStop Color="#50FF8F00" Offset="0.5" />
        <GradientStop Color="#00FF8F00" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
