<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== BACKGROUNDS (Deep Cyber Obsidian & Holographic Glass) ==================== -->
    <Color x:Key="BgDarkest">#05070D</Color>
    <Color x:Key="BgSidebar">#080C15</Color>
    <Color x:Key="BgMain">#0A0F1D</Color>
    <Color x:Key="BgCard">#0F1626</Color>
    <Color x:Key="BgCardHover">#152037</Color>
    <Color x:Key="BgCardActive">#1C2B49</Color>
    <Color x:Key="BgInput">#0A101C</Color>
    <Color x:Key="BgPopup">#0E1628</Color>
    <Color x:Key="BgGlassFrosted">#182338</Color>

    <!-- ==================== ACCENT PALETTE (Electric Cyber Spectrum) ==================== -->
    <!-- Hyper Ion Cyan (Primary Brand) -->
    <Color x:Key="AccentCyan">#00F2FE</Color>
    <Color x:Key="AccentCyanBright">#38BDF8</Color>
    <Color x:Key="AccentCyanDeep">#0284C7</Color>
    <Color x:Key="AccentCyanGlow">#4000F2FE</Color>

    <!-- Ultraviolet & Plasma Violet (Secondary) -->
    <Color x:Key="AccentViolet">#A855F7</Color>
    <Color x:Key="AccentVioletDeep">#7C3AED</Color>
    <Color x:Key="AccentMagenta">#F43F5E</Color>
    <Color x:Key="AccentPink">#EC4899</Color>

    <!-- Quantum Emerald (Success / Live Engine) -->
    <Color x:Key="AccentGreen">#10B981</Color>
    <Color x:Key="AccentGreenBright">#00E676</Color>
    <Color x:Key="AccentGreenDeep">#059669</Color>
    <Color x:Key="AccentGreenGlow">#3310B981</Color>

    <!-- Solar Amber (Warning / Notice) -->
    <Color x:Key="AccentAmber">#F59E0B</Color>
    <Color x:Key="AccentAmberBright">#FBBF24</Color>

    <!-- Alert Crimson (Danger / Offline) -->
    <Color x:Key="AccentRed">#EF4444</Color>
    <Color x:Key="AccentRuby">#F43F5E</Color>

    <!-- ==================== BORDER & STROKE SYSTEM ==================== -->
    <Color x:Key="BorderLight">#22324D</Color>
    <Color x:Key="BorderSubtle">#141E30</Color>
    <Color x:Key="BorderGlowCyan">#6600F2FE</Color>
    <Color x:Key="BorderCardTopHighlight">#3338BDF8</Color>
    <Color x:Key="BorderFrostedTop">#25FFFFFF</Color>

    <!-- ==================== TEXT HIERARCHY ==================== -->
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#94A3B8</Color>
    <Color x:Key="TextMuted">#64748B</Color>

    <!-- ==================== SOLID COLOR BRUSHES ==================== -->
    <SolidColorBrush x:Key="BrushBgDarkest" Color="{StaticResource BgDarkest}" />
    <SolidColorBrush x:Key="BrushBgSidebar" Color="{StaticResource BgSidebar}" />
    <SolidColorBrush x:Key="BrushBgMain" Color="{StaticResource BgMain}" />
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource BgCard}" />
    <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource BgCardHover}" />
    <SolidColorBrush x:Key="BrushBgCardActive" Color="{StaticResource BgCardActive}" />
    <SolidColorBrush x:Key="BrushBgInput" Color="{StaticResource BgInput}" />
    <SolidColorBrush x:Key="BrushBgPopup" Color="{StaticResource BgPopup}" />
    <SolidColorBrush x:Key="BrushBgGlassFrosted" Color="{StaticResource BgGlassFrosted}" />

    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource AccentCyan}" />
    <SolidColorBrush x:Key="BrushAccentCyanBright" Color="{StaticResource AccentCyanBright}" />
    <SolidColorBrush x:Key="BrushAccentCyanDeep" Color="{StaticResource AccentCyanDeep}" />
    <SolidColorBrush x:Key="BrushAccentCyanGlow" Color="{StaticResource AccentCyanGlow}" />
    <SolidColorBrush x:Key="BrushAccentViolet" Color="{StaticResource AccentViolet}" />
    <SolidColorBrush x:Key="BrushAccentVioletDeep" Color="{StaticResource AccentVioletDeep}" />
    <SolidColorBrush x:Key="BrushAccentGreen" Color="{StaticResource AccentGreen}" />
    <SolidColorBrush x:Key="BrushAccentGreenBright" Color="{StaticResource AccentGreenBright}" />
    <SolidColorBrush x:Key="BrushAccentAmber" Color="{StaticResource AccentAmber}" />
    <SolidColorBrush x:Key="BrushAccentRed" Color="{StaticResource AccentRed}" />
    <SolidColorBrush x:Key="BrushAccentRuby" Color="{StaticResource AccentRuby}" />

    <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource BorderSubtle}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource TextMuted}" />

    <!-- ==================== PREMIUM GRADIENTS ==================== -->
    <!-- Obsidian Window Backdrop Mesh -->
    <RadialGradientBrush x:Key="BrushWindowBackdropGradient" Center="0.5,0.0" GradientOrigin="0.5,0.0" RadiusX="1.0" RadiusY="1.0">
        <GradientStop Color="#141E33" Offset="0" />
        <GradientStop Color="#0A0F1D" Offset="0.5" />
        <GradientStop Color="#060911" Offset="1" />
    </RadialGradientBrush>

    <!-- Sidebar Mesh Gradient -->
    <LinearGradientBrush x:Key="BrushSidebarGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#090E19" Offset="0" />
        <GradientStop Color="#060A12" Offset="1" />
    </LinearGradientBrush>

    <!-- Hero Ion Cyan Gradient -->
    <LinearGradientBrush x:Key="BrushCyanGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00F2FE" Offset="0" />
        <GradientStop Color="#38BDF8" Offset="0.5" />
        <GradientStop Color="#0284C7" Offset="1" />
    </LinearGradientBrush>

    <!-- Ultraviolet Plasma Gradient -->
    <LinearGradientBrush x:Key="BrushVioletGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C084FC" Offset="0" />
        <GradientStop Color="#A855F7" Offset="0.5" />
        <GradientStop Color="#7C3AED" Offset="1" />
    </LinearGradientBrush>

    <!-- Quantum Emerald Gradient -->
    <LinearGradientBrush x:Key="BrushGreenGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#34D399" Offset="0" />
        <GradientStop Color="#10B981" Offset="0.6" />
        <GradientStop Color="#059669" Offset="1" />
    </LinearGradientBrush>

    <!-- Solar Amber Glow Gradient -->
    <LinearGradientBrush x:Key="BrushAmberGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FBBF24" Offset="0" />
        <GradientStop Color="#F59E0B" Offset="0.7" />
        <GradientStop Color="#D97706" Offset="1" />
    </LinearGradientBrush>

    <!-- Cyber Ruby Alert Gradient -->
    <LinearGradientBrush x:Key="BrushRubyGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FB7185" Offset="0" />
        <GradientStop Color="#F43F5E" Offset="0.6" />
        <GradientStop Color="#E11D48" Offset="1" />
    </LinearGradientBrush>

    <!-- Holographic Glass Card Surface Gradient -->
    <LinearGradientBrush x:Key="BrushCardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#131C2E" Offset="0" />
        <GradientStop Color="#0D1422" Offset="0.4" />
        <GradientStop Color="#090E18" Offset="1" />
    </LinearGradientBrush>

    <!-- Hero Score Cockpit Gradient -->
    <LinearGradientBrush x:Key="BrushScoreGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00F2FE" Offset="0" />
        <GradientStop Color="#818CF8" Offset="0.5" />
        <GradientStop Color="#C084FC" Offset="1" />
    </LinearGradientBrush>

    <!-- Active Segment Tab Glowing Pill -->
    <LinearGradientBrush x:Key="BrushNavActiveGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2500F2FE" Offset="0" />
        <GradientStop Color="#0800F2FE" Offset="0.8" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <!-- Frosted Top-Border Highlight Stroke -->
    <LinearGradientBrush x:Key="BrushCardTopHighlight" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0038BDF8" Offset="0" />
        <GradientStop Color="#4038BDF8" Offset="0.5" />
        <GradientStop Color="#0038BDF8" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
