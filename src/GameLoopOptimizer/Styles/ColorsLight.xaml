<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== BACKGROUNDS (Sleek Slate Glass & Modern Light Canvas) ==================== -->
    <Color x:Key="BgDarkest">#E2E8F0</Color>
    <Color x:Key="BgSidebar">#F8FAFC</Color>
    <Color x:Key="BgMain">#FFFFFF</Color>
    <Color x:Key="BgCard">#FFFFFF</Color>
    <Color x:Key="BgCardHover">#FFF7ED</Color>
    <Color x:Key="BgCardActive">#FFEDD5</Color>
    <Color x:Key="BgInput">#F8FAFC</Color>
    <Color x:Key="BgPopup">#FFFFFF</Color>
    <Color x:Key="BgGlassFrosted">#F1F5F9</Color>

    <!-- ==================== ACCENT PALETTE (Vibrant Sunset Orange & Crisp Amber) ==================== -->
    <!-- Crisp High-Octane Sunset Orange -->
    <Color x:Key="AccentCyan">#EA580C</Color>
    <Color x:Key="AccentCyanBright">#C2410C</Color>
    <Color x:Key="AccentCyanDeep">#9A3412</Color>
    <Color x:Key="AccentCyanGlow">#25EA580C</Color>

    <!-- Solar Amber & Flame -->
    <Color x:Key="AccentViolet">#D97706</Color>
    <Color x:Key="AccentVioletDeep">#B45309</Color>
    <Color x:Key="AccentMagenta">#E11D48</Color>
    <Color x:Key="AccentPink">#BE123C</Color>

    <!-- Quantum Emerald -->
    <Color x:Key="AccentGreen">#059669</Color>
    <Color x:Key="AccentGreenBright">#10B981</Color>
    <Color x:Key="AccentGreenDeep">#047857</Color>
    <Color x:Key="AccentGreenGlow">#2510B981</Color>

    <!-- Solar Amber -->
    <Color x:Key="AccentAmber">#D97706</Color>
    <Color x:Key="AccentAmberBright">#F59E0B</Color>

    <!-- Alert Crimson / Ruby -->
    <Color x:Key="AccentRed">#DC2626</Color>
    <Color x:Key="AccentRuby">#E11D48</Color>

    <!-- ==================== BORDER & STROKE SYSTEM ==================== -->
    <Color x:Key="BorderLight">#CBD5E1</Color>
    <Color x:Key="BorderSubtle">#E2E8F0</Color>
    <Color x:Key="BorderGlowCyan">#40EA580C</Color>
    <Color x:Key="BorderCardTopHighlight">#30FB923C</Color>
    <Color x:Key="BorderFrostedTop">#15000000</Color>

    <!-- ==================== TEXT HIERARCHY (Razor-Sharp Slate) ==================== -->
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="TextMuted">#64748B</Color>

    <!-- ==================== SOLID COLOR BRUSHES ==================== -->
    <SolidColorBrush x:Key="BrushBgDarkest" Color="{StaticResource BgDarkest}" />
    <SolidColorBrush x:Key="BrushBgSidebar" Color="{StaticResource BgSidebar}" />
    <SolidColorBrush x:Key="BrushBgMain" Color="{StaticResource BgMain}" />
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource BgCard}" />
    <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource BgCardHover}" />
    <SolidColorBrush x:Key="BrushBgCardActive" Color="{StaticResource BgCardActive}" />
    <SolidColorBrush x:Key="BrushBgInput" Color="{StaticResource BgInput}" />
    <SolidColorBrush x:Key="BrushBgPopup" Color="{StaticResource BgPopup}" />
    <SolidColorBrush x:Key="BrushBgGlassFrosted" Color="{StaticResource BgGlassFrosted}" />

    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource AccentCyan}" />
    <SolidColorBrush x:Key="BrushAccentCyanBright" Color="{StaticResource AccentCyanBright}" />
    <SolidColorBrush x:Key="BrushAccentCyanDeep" Color="{StaticResource AccentCyanDeep}" />
    <SolidColorBrush x:Key="BrushAccentCyanGlow" Color="{StaticResource AccentCyanGlow}" />
    <SolidColorBrush x:Key="BrushAccentViolet" Color="{StaticResource AccentViolet}" />
    <SolidColorBrush x:Key="BrushAccentVioletDeep" Color="{StaticResource AccentVioletDeep}" />
    <SolidColorBrush x:Key="BrushAccentGreen" Color="{StaticResource AccentGreen}" />
    <SolidColorBrush x:Key="BrushAccentGreenBright" Color="{StaticResource AccentGreenBright}" />
    <SolidColorBrush x:Key="BrushAccentAmber" Color="{StaticResource AccentAmber}" />
    <SolidColorBrush x:Key="BrushAccentRed" Color="{StaticResource AccentRed}" />
    <SolidColorBrush x:Key="BrushAccentRuby" Color="{StaticResource AccentRuby}" />

    <SolidColorBrush x:Key="BrushBorderLight" Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource BorderSubtle}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource TextMuted}" />

    <!-- ==================== PREMIUM GRADIENTS (Warm Sunset Light) ==================== -->
    <RadialGradientBrush x:Key="BrushWindowBackdropGradient" Center="0.5,0.0" GradientOrigin="0.5,0.0" RadiusX="1.0" RadiusY="1.0">
        <GradientStop Color="#FFF7ED" Offset="0" />
        <GradientStop Color="#F8FAFC" Offset="0.6" />
        <GradientStop Color="#F1F5F9" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="BrushSidebarGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F8FAFC" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCyanGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FB923C" Offset="0" />
        <GradientStop Color="#EA580C" Offset="0.6" />
        <GradientStop Color="#C2410C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushVioletGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F59E0B" Offset="0" />
        <GradientStop Color="#D97706" Offset="0.6" />
        <GradientStop Color="#B45309" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGreenGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0" />
        <GradientStop Color="#059669" Offset="0.6" />
        <GradientStop Color="#047857" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushAmberGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FBBF24" Offset="0" />
        <GradientStop Color="#F59E0B" Offset="0.7" />
        <GradientStop Color="#D97706" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushRubyGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F43F5E" Offset="0" />
        <GradientStop Color="#E11D48" Offset="0.6" />
        <GradientStop Color="#BE123C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FAFAFA" Offset="0.5" />
        <GradientStop Color="#F5F5F7" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushScoreGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FB923C" Offset="0" />
        <GradientStop Color="#EA580C" Offset="0.6" />
        <GradientStop Color="#DC2626" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushNavActiveGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#25EA580C" Offset="0" />
        <GradientStop Color="#08EA580C" Offset="0.8" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCardTopHighlight" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FB923C" Offset="0" />
        <GradientStop Color="#40FB923C" Offset="0.5" />
        <GradientStop Color="#00FB923C" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
