<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <Version>2.1.0</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <AssemblyTitle>HMW GameLoop Precision Engine Optimizer</AssemblyTitle>
    <Product>GameLoop Optimizer</Product>
    <Description>Precision Engine and Stretched Resolution Optimizer for GameLoop</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icons/images are consumed by XAML, so they stay WPF Resources. The .sav files are
         opaque binary payloads that WPF's Resource build action does not understand, so they
         ship as loose files next to the executable instead. Drop a new .sav into Assets\ and
         it is picked up automatically by ActiveSavService.DiscoverBundledSaves(). -->
    <Resource Include="Assets\**" Exclude="Assets\*.sav" />
    <None Include="Assets\*.sav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.1" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.1" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.1" />
    <PackageReference Include="Vortice.Mathematics" Version="2.0.0" />
  </ItemGroup>

</Project>
